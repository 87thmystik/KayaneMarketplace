@model Kayane.ViewModels.TwoFactorVerifyVM

@{
    ViewData["Title"] = "Two-Factor Verification";
}

<div class="min-h-screen flex items-center justify-center bg-slate-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6 bg-slate-800 border border-slate-700 p-8 rounded-2xl shadow-xl">

        <div class="text-center space-y-2">
            <div class="w-14 h-14 bg-rose-600 rounded-2xl flex items-center justify-center text-white font-black text-2xl mx-auto shadow-lg">
                🔐
            </div>
            <h1 class="text-2xl font-extrabold text-white mt-4">Two-Factor Verification</h1>
            <p class="text-xs text-slate-400">Enter the 6-digit code from your authenticator app</p>
        </div>

        <form asp-action="TwoFactor" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="text-rose-300 text-xs font-semibold bg-rose-900/30 border border-rose-800 p-3 rounded-xl"></div>

            <div>
                <label asp-for="Code" class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">
                    <span x-data="{ recovery: false }" x-init="recovery = false">
                        <span x-show="!recovery">Verification Code</span>
                    </span>
                </label>
                <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code"
                       pattern="[A-Za-z0-9 ]*" maxlength="10" required autofocus
                       class="w-full px-4 py-3 bg-slate-900 border border-slate-600 rounded-xl text-lg text-white text-center font-mono tracking-widest placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-rose-500"
                       placeholder="000000" />
                <span asp-validation-for="Code" class="text-rose-400 text-xs mt-1 block"></span>
            </div>

            <label class="flex items-center gap-2">
                <input asp-for="UseRecoveryCode" type="checkbox"
                       class="h-4 w-4 text-rose-600 focus:ring-rose-500 bg-slate-900 border-slate-600 rounded" />
                <span class="text-xs text-slate-300">Use a recovery code instead</span>
            </label>

            <button type="submit"
                    class="w-full py-3 bg-rose-600 hover:bg-rose-700 text-white text-sm font-bold rounded-xl transition shadow-lg">
                Verify &amp; Sign In
            </button>
        </form>

        <div class="border-t border-slate-700 pt-4 text-center">
            <a asp-action="Login" class="text-xs font-semibold text-slate-400 hover:text-white">
                ← Back to login
            </a>
        </div>
    </div>
</div>