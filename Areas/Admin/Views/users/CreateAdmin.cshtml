@model Kayane.ViewModels.AdminCreateVM

@{
    ViewData["Title"] = "Create Admin";
}

<div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <div>
        <a asp-action="Index" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">← Back to Users</a>
        <h1 class="text-3xl font-extrabold text-gray-900 mt-2">Create Admin</h1>
        <p class="text-sm text-gray-500 mt-1">
            Only the Super Admin can create new admin accounts.
        </p>
    </div>

    <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-xs font-medium">
        ⚠️ <strong>Super Admin action.</strong> The new admin will have full moderation access.
    </div>

    <form asp-action="CreateAdmin" method="post"
          class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-5">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 font-medium"></div>

        <div>
            <label asp-for="Name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Full Name</label>
            <input asp-for="Name" required
                   class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            <span asp-validation-for="Name" class="text-xs text-rose-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Email Address</label>
            <input asp-for="Email" type="email" required
                   class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
            <p class="text-[10px] text-gray-400 mt-1">Use the email they'll log in with. Auto-verified.</p>
        </div>

        <div>
            <label asp-for="Phone" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Phone Number <span class="text-gray-400 font-normal normal-case">(optional)</span></label>
            <input asp-for="Phone"
                   class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            <span asp-validation-for="Phone" class="text-xs text-rose-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Temporary Password</label>
            <input asp-for="Password" type="password" required minlength="8"
                   placeholder="At least 8 characters"
                   class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            <span asp-validation-for="Password" class="text-xs text-rose-500 mt-1 block"></span>
            <p class="text-[10px] text-gray-400 mt-1">Share this with them securely. They can change it after logging in.</p>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" required
                   class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-500 mt-1 block"></span>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
            <a asp-action="Index" class="px-5 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50">Cancel</a>
            <button type="submit"
                    onclick="return confirm('Create this admin account?')"
                    class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                Create Admin
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}