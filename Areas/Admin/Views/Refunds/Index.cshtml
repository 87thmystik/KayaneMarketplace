@model Kayane.ViewModels.RefundQueueVM

@{
    ViewData["Title"] = "Refund Queue";

    string FilterClass(string f) =>
        Model.CurrentFilter == f
            ? "bg-indigo-600 text-white shadow-sm"
            : "bg-gray-100 text-gray-600 hover:bg-gray-200";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-200 pb-6">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Refund Queue</h1>
            <p class="text-sm text-gray-500 mt-1">
                Cancelled orders flagged for refund. Process each one manually or via 9PSB when live.
            </p>
        </div>
        @if (Model.PendingCount > 0)
        {
            <div class="bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 flex items-center gap-3">
                <span class="text-2xl">💰</span>
                <div>
                    <p class="text-xs font-semibold text-amber-700 uppercase tracking-wider">Pending Refunds</p>
                    <p class="text-xl font-extrabold text-amber-900">
                        @Model.PendingTotal.ToString("C")
                        <span class="text-sm font-medium text-amber-700 ml-1">(@Model.PendingCount)</span>
                    </p>
                </div>
            </div>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm rounded-xl font-medium">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm rounded-xl font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Filter tabs -->
    <div class="flex flex-wrap gap-2 border-b border-gray-200 pb-3">
        <a asp-action="Index" asp-route-filter="pending"
           class="px-4 py-2 text-xs font-bold rounded-xl transition flex items-center gap-1.5 @FilterClass("pending")">
            Pending
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800">@Model.PendingCount</span>
        </a>
        <a asp-action="Index" asp-route-filter="processed"
           class="px-4 py-2 text-xs font-bold rounded-xl transition flex items-center gap-1.5 @FilterClass("processed")">
            Processed
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800">@Model.ProcessedCount</span>
        </a>
        <a asp-action="Index" asp-route-filter="all"
           class="px-4 py-2 text-xs font-bold rounded-xl transition @FilterClass("all")">
            All
        </a>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        @if (!Model.Items.Any())
        {
            <div class="p-16 text-center space-y-2">
                <div class="text-5xl">✓</div>
                <p class="font-bold text-gray-900">No refunds to show</p>
                <p class="text-sm text-gray-500">
                    @if (Model.CurrentFilter == "pending")
                    {
                        <text>Nothing pending — you're caught up.</text>
                    }
                    else
                    {
                        <text>Nothing to display for this filter.</text>
                    }
                </p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-[11px] uppercase font-bold text-gray-400 border-b border-gray-200 tracking-wider">
                            <th class="px-6 py-3">Order / Date</th>
                            <th class="px-6 py-3">Buyer</th>
                            <th class="px-6 py-3">Vendors</th>
                            <th class="px-6 py-3">Amount</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-gray-50/80 transition align-top">
                                <td class="px-6 py-4">
                                    <div class="font-mono font-bold text-xs text-gray-900">
                                        #@item.OrderId.ToString()[..8]
                                    </div>
                                    <div class="text-[10px] text-gray-400 mt-0.5">
                                        Ordered @item.PaymentCreatedAt.ToString("MMM dd, yyyy")
                                    </div>
                                    <div class="text-[10px] font-mono text-gray-400">
                                        @item.PaymentReference
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-semibold text-gray-900 text-xs">@item.BuyerName</div>
                                    <div class="text-[10px] text-gray-500 break-all">@item.BuyerEmail</div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.Vendors.Any())
                                    {
                                        <ul class="space-y-0.5">
                                            @foreach (var v in item.Vendors)
                                            {
                                                <li class="text-xs text-gray-700">
                                                    @v.VendorName
                                                    <span class="text-gray-400">·</span>
                                                    <span class="font-semibold">@v.Amount.ToString("C")</span>
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400 italic">No vendor data</span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-extrabold text-gray-900">@item.Amount.ToString("C")</div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.IsProcessed)
                                    {
                                        <span class="inline-flex px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                            ✓ Refunded
                                        </span>
                                        @if (item.RefundedAt.HasValue)
                                        {
                                            <div class="text-[10px] text-gray-400 mt-1">
                                                @item.RefundedAt.Value.ToLocalTime().ToString("MMM dd, HH:mm")
                                                @if (!string.IsNullOrEmpty(item.RefundedByName))
                                                {
                                                    <text>· by @item.RefundedByName</text>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="inline-flex px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                            Pending
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    @if (!item.IsProcessed)
                                    {
                                        <form asp-action="MarkProcessed" method="post" class="inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="paymentId" value="@item.PaymentId" />
                                            <input type="hidden" name="note" value="" />
                                            <button type="submit"
                                                    onclick="return confirm('Mark this refund as processed? The buyer will be notified.')"
                                                    class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition shadow-sm whitespace-nowrap">
                                                Mark Processed
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400 italic">Done</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
                    <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="flex items-center justify-between border-t border-gray-200 px-6 py-4">
                <p class="text-xs text-gray-500">
                    Showing page <span class="font-bold text-gray-800">@Model.CurrentPage</span> of
                    <span class="font-bold text-gray-800">@Model.TotalPages</span>
                    (@Model.TotalItems total)
                </p>
                <div class="flex items-center gap-2">
                    <a asp-action="Index"
                       asp-route-filter="@Model.CurrentFilter"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       class="px-3 py-1.5 text-xs font-semibold border border-gray-300 rounded-lg text-gray-600 transition @(!Model.HasPreviousPage ? "opacity-50 pointer-events-none" : "hover:bg-gray-100")">
                        Previous
                    </a>
                    <a asp-action="Index"
                       asp-route-filter="@Model.CurrentFilter"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       class="px-3 py-1.5 text-xs font-semibold border border-gray-300 rounded-lg text-gray-600 transition @(!Model.HasNextPage ? "opacity-50 pointer-events-none" : "hover:bg-gray-100")">
                        Next
                    </a>
                </div>
            </div>
        }
        }
    </div>
</div>