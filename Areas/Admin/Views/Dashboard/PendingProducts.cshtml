@model List<Kayane.Models.Product>
@using Kayane.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Product Moderation Queue";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-200 pb-6">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Product Moderation Queue</h1>
            <p class="text-sm text-gray-500 mt-1">Review vendor product submissions before publishing them live to the store.</p>
        </div>
        <div class="flex items-center gap-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 self-start sm:self-auto">
                @Model.Count Pending Item(s)
            </span>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">
                ← Back to Admin Dashboard
            </a>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium flex justify-between items-center">
            <span>@TempData["SuccessMessage"]</span>
            <button onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-900 font-bold">&times;</button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded-xl text-sm font-medium flex justify-between items-center">
            <span>@TempData["ErrorMessage"]</span>
            <button onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-900 font-bold">&times;</button>
        </div>
    }

    <!-- Moderation Queue Table -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-xs uppercase font-semibold text-gray-500 border-b border-gray-200">
                            <th class="px-6 py-3.5">Product</th>
                            <th class="px-6 py-3.5">Vendor</th>
                            <th class="px-6 py-3.5">Category</th>
                            <th class="px-6 py-3.5">Price</th>
                            <th class="px-6 py-3.5">Stock</th>
                            <th class="px-6 py-3.5">Submitted</th>
                            <th class="px-6 py-3.5 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var product in Model)
                        {
                            <tr class="hover:bg-gray-50/80 transition">
                                <td class="px-6 py-4">
                                    <p class="font-bold text-gray-900">@product.Name</p>
                                    <p class="text-xs text-gray-500 line-clamp-1 max-w-xs mt-0.5">@product.Description</p>
                                </td>
                                <td class="px-6 py-4 font-medium text-gray-800">
                                    @(product.Vendor?.BusinessName ?? "Kayane Partner")
                                </td>
                                <td class="px-6 py-4 text-gray-600">
                                    @(product.Category?.Name ?? "Uncategorized")
                                </td>
                                <td class="px-6 py-4 font-semibold text-gray-900">
                                    @product.Price.ToString("C")
                                </td>
                                <td class="px-6 py-4 text-gray-700">
                                    @product.Stock units
                                </td>
                                <td class="px-6 py-4 text-gray-500 text-xs">
                                    @product.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <form asp-area="Admin" asp-controller="Dashboard" asp-action="UpdateProductStatus" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.ProductId" />
                                            <input type="hidden" name="status" value="@ProductStatus.Approved" />
                                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                                            <button type="submit" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition shadow-sm">
                                                Approve
                                            </button>
                                        </form>
                                        <form asp-area="Admin" asp-controller="Dashboard" asp-action="UpdateProductStatus" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.ProductId" />
                                            <input type="hidden" name="status" value="@ProductStatus.Rejected" />
                                            <input type="hidden" name="returnUrl" value="@currentUrl" />
                                            <button type="submit" class="px-3 py-1.5 bg-red-50 text-red-700 hover:bg-red-100 border border-red-200 text-xs font-semibold rounded-lg transition">
                                                Reject
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-gray-500 space-y-2">
                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center font-bold text-xl mx-auto mb-3">
                    ✓
                </div>
                <p class="text-base font-semibold text-gray-900">Moderation Queue Clear</p>
                <p class="text-xs text-gray-400">There are no pending product submissions requiring approval right now.</p>
            </div>
        }
    </div>
</div>