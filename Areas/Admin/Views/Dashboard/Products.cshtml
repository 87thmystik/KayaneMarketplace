@model List<Kayane.ViewModels.ProductModerationVM>
@using Kayane.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Product Moderation";
    var selectedStatus = ViewBag.SelectedStatus as ProductStatus?;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-gray-200 pb-6">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Product Moderation</h1>
            <p class="text-sm text-gray-500 mt-1">Review, approve, or reject seller product listings across the platform.</p>
        </div>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">
            ← Back to Admin Dashboard
        </a>
    </div>

    <!-- Status Filters -->
    <div class="flex items-center gap-2 border-b border-gray-200 pb-2">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Products" class="px-4 py-2 text-xs font-bold rounded-xl transition @(selectedStatus == null ? "bg-indigo-600 text-white" : "bg-white text-gray-600 hover:bg-gray-100")">
            All Statuses
        </a>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Products" asp-route-statusFilter="@ProductStatus.Pending" class="px-4 py-2 text-xs font-bold rounded-xl transition @(selectedStatus == ProductStatus.Pending ? "bg-indigo-600 text-white" : "bg-white text-gray-600 hover:bg-gray-100")">
            Pending
        </a>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Products" asp-route-statusFilter="@ProductStatus.Approved" class="px-4 py-2 text-xs font-bold rounded-xl transition @(selectedStatus == ProductStatus.Approved ? "bg-indigo-600 text-white" : "bg-white text-gray-600 hover:bg-gray-100")">
            Approved
        </a>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Products" asp-route-statusFilter="@ProductStatus.Rejected" class="px-4 py-2 text-xs font-bold rounded-xl transition @(selectedStatus == ProductStatus.Rejected ? "bg-indigo-600 text-white" : "bg-white text-gray-600 hover:bg-gray-100")">
            Rejected
        </a>
    </div>

    <!-- Products Moderation Table -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-xs uppercase font-semibold text-gray-500 border-b border-gray-200">
                            <th class="px-6 py-3.5">Product Name</th>
                            <th class="px-6 py-3.5">Vendor</th>
                            <th class="px-6 py-3.5">Category</th>
                            <th class="px-6 py-3.5">Price / Stock</th>
                            <th class="px-6 py-3.5">Status</th>
                            <th class="px-6 py-3.5 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var product in Model)
                        {
                            <tr class="hover:bg-gray-50/80 transition">
                                <td class="px-6 py-4 font-bold text-gray-900">@product.Name</td>
                                <td class="px-6 py-4 text-xs font-semibold text-gray-700">@product.BusinessName</td>
                                <td class="px-6 py-4 text-xs text-gray-500">@product.CategoryName</td>
                                <td class="px-6 py-4">
                                    <p class="font-bold text-gray-900">$@product.Price.ToString("F2")</p>
                                    <p class="text-xs text-gray-500">Stock: @product.Stock</p>
                                </td>
                                <td class="px-6 py-4">
                                    @switch (product.Status)
                                    {
                                        case ProductStatus.Approved:
                                            <span class="px-2.5 py-1 text-xs font-bold bg-emerald-100 text-emerald-800 rounded-full">Approved</span>
                                            break;
                                        case ProductStatus.Pending:
                                            <span class="px-2.5 py-1 text-xs font-bold bg-amber-100 text-amber-800 rounded-full">Pending</span>
                                            break;
                                        case ProductStatus.Rejected:
                                            <span class="px-2.5 py-1 text-xs font-bold bg-red-100 text-red-800 rounded-full">Rejected</span>
                                            break;
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (product.Status != ProductStatus.Approved)
                                        {
                                            <form asp-area="Admin" asp-controller="Dashboard" asp-action="UpdateProductStatus" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@product.ProductId" />
                                                <input type="hidden" name="status" value="@ProductStatus.Approved" />
                                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                <button type="submit" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition">
                                                    Approve
                                                </button>
                                            </form>
                                        }

                                        @if (product.Status != ProductStatus.Rejected)
                                        {
                                            <form asp-area="Admin" asp-controller="Dashboard" asp-action="UpdateProductStatus" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@product.ProductId" />
                                                <input type="hidden" name="status" value="@ProductStatus.Rejected" />
                                                <input type="hidden" name="returnUrl" value="@currentUrl" />
                                                <button type="submit" class="px-3 py-1 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold rounded-lg transition">
                                                    Reject
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-gray-500 text-sm">
                No products found matching the criteria.
            </div>
        }
    </div>
</div>