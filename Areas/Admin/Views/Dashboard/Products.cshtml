@model Kayane.ViewModels.ModerationQueueVM
@using Kayane.Models

@{
    ViewData["Title"] = "Product Moderation";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header -->
    <div class="border-b border-gray-200 pb-6">
        <h1 class="text-3xl font-extrabold text-gray-900">Product Moderation</h1>
        <p class="text-sm text-gray-500 mt-1">Review vendor product submissions.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Status tabs -->
    <div class="flex flex-wrap gap-2 border-b border-gray-200 pb-3">
        <a asp-action="Index" asp-route-status="@ProductStatus.Pending"
           class="px-4 py-2 text-xs font-bold rounded-xl transition flex items-center gap-1.5 @(Model.CurrentFilter == ProductStatus.Pending ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
            Pending
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800">@Model.PendingCount</span>
        </a>
        <a asp-action="Index" asp-route-status="@ProductStatus.Approved"
           class="px-4 py-2 text-xs font-bold rounded-xl transition flex items-center gap-1.5 @(Model.CurrentFilter == ProductStatus.Approved ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
            Approved
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800">@Model.ApprovedCount</span>
        </a>
        <a asp-action="Index" asp-route-status="@ProductStatus.Rejected"
           class="px-4 py-2 text-xs font-bold rounded-xl transition flex items-center gap-1.5 @(Model.CurrentFilter == ProductStatus.Rejected ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
            Rejected
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-rose-100 text-rose-800">@Model.RejectedCount</span>
        </a>
    </div>

    <!-- Table -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        @if (!Model.Products.Any())
        {
            <div class="p-12 text-center text-gray-500 text-sm">
                No products in the <strong>@Model.CurrentFilter</strong> queue.
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-xs uppercase font-semibold text-gray-500 border-b border-gray-200">
                            <th class="px-6 py-3.5">Product</th>
                            <th class="px-6 py-3.5">Vendor</th>
                            <th class="px-6 py-3.5">Category</th>
                            <th class="px-6 py-3.5">Price</th>
                            <th class="px-6 py-3.5">Stock</th>
                            <th class="px-6 py-3.5">Submitted</th>
                            <th class="px-6 py-3.5 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var item in Model.Products)
                        {
                            <tr class="hover:bg-gray-50/80 transition">
                                <td class="px-6 py-4">
                                    <div class="font-bold text-gray-900">@item.Name</div>
                                    <div class="text-xs text-gray-500 line-clamp-1 max-w-xs mt-0.5">@item.Description</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="text-xs font-semibold text-gray-700">@item.VendorBusinessName</span>
                                </td>
                                <td class="px-6 py-4 text-xs text-gray-600">@item.CategoryName</td>
                                <td class="px-6 py-4 font-bold text-gray-900">@item.Price.ToString("C")</td>
                                <td class="px-6 py-4 text-gray-700">@item.Stock</td>
                                <td class="px-6 py-4 text-xs text-gray-500">
                                    @item.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        @if (item.Status == ProductStatus.Pending || item.Status == ProductStatus.Rejected)
                                        {
                                            <form asp-action="Approve" asp-route-id="@item.ProductId" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition shadow-sm">
                                                    Approve
                                                </button>
                                            </form>
                                        }

                                        @if (item.Status == ProductStatus.Pending || item.Status == ProductStatus.Approved)
                                        {
                                            <button type="button"
                                                @@click="$dispatch('open-reject-modal', { id: '@item.ProductId', name: @System.Text.Json.JsonSerializer.Serialize(item.Name) })"
                                                    class="px-3 py-1.5 bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 text-xs font-semibold rounded-lg transition">
                                                Reject
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Reject modal (Alpine) -->
<div x-data="{ open: false, productId: '', productName: '' }"
    @@open-reject-modal.window="open = true; productId = $event.detail.id; productName = $event.detail.name"
     x-show="open"
     x-cloak
     class="fixed inset-0 z-50 flex items-center justify-center p-4">

    <div class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm" @@click="open = false"></div>

    <div class="relative bg-white rounded-2xl shadow-xl max-w-md w-full p-6 space-y-4">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h3 class="text-lg font-bold text-gray-900">Reject Product</h3>
                <p class="text-xs text-gray-500 mt-0.5" x-text="productName"></p>
            </div>
            <button type="button" @@click="open = false" class="text-gray-400 hover:text-gray-700 text-xl leading-none">&times;</button>
        </div>

        <form asp-action="Reject" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" :value="productId" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Reason for Rejection</label>
                <textarea name="rejectionReason" rows="3" required
                          placeholder="Explain why this product is being rejected..."
                          class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-rose-500 focus:outline-none"></textarea>
            </div>

            <div class="flex justify-end gap-2 pt-2 border-t border-gray-100">
                <button type="button" @@click="open = false"
                        class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-xl transition">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-xl transition shadow-sm">
                    Confirm Rejection
                </button>
            </div>
        </form>
    </div>
</div>