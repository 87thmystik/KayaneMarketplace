@model Kayane.ViewModels.VendorWalletVM
@using Kayane.Models

@{
    ViewData["Title"] = "Wallet & Payouts";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Header -->
    <div class="border-b border-gray-200 pb-6">
        <h1 class="text-3xl font-extrabold text-gray-900">Wallet & Payouts</h1>
        <p class="text-sm text-gray-500 mt-1">Manage your earnings and request withdrawals to your bank account.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm rounded-xl font-medium">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm rounded-xl font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Balance + Bank cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Available Balance</p>
            <p class="text-4xl font-extrabold text-gray-900 mt-2">@Model.Balance.ToString("C")</p>
            <p class="text-xs text-emerald-600 font-semibold mt-1">Ready to withdraw</p>

            <div class="border-t border-gray-100 mt-4 pt-4">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Lifetime Earnings</p>
                <p class="text-xl font-bold text-gray-800 mt-1">@Model.TotalEarnings.ToString("C")</p>
            </div>
        </div>

        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 space-y-4">
            <div>
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Destination Bank Account</p>
                @if (!string.IsNullOrEmpty(Model.AccountNumber))
                {
                    <p class="text-sm font-bold text-gray-900">@Model.AccountNumber</p>
                    <p class="text-xs text-gray-500">Bank Code: @Model.BankCode</p>
                }
                else
                {
                    <p class="text-sm text-amber-700 font-medium">Bank details not set up.</p>
                    <a asp-controller="Vendor" asp-action="EditProfile"
                       class="inline-block mt-1 text-xs font-semibold text-indigo-600 hover:underline">
                        Add bank details →
                    </a>
                }
            </div>

            @if (Model.Balance > 0 && !string.IsNullOrEmpty(Model.AccountNumber))
            {
                <div class="border-t border-gray-100 pt-4">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Request a Withdrawal</p>
                    <form asp-controller="VendorWallet" asp-action="RequestPayout" method="post" class="flex flex-col sm:flex-row gap-2">
                        @Html.AntiForgeryToken()
                        <input type="number" name="Amount" step="0.01" min="1" max="@Model.Balance"
                               placeholder="Amount (₦)" required
                               class="flex-1 px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        <button type="submit"
                                class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                            Request
                        </button>
                    </form>
                    <p class="text-xs text-gray-400 mt-1">Maximum: @Model.Balance.ToString("C")</p>
                </div>
            }
            else if (Model.Balance <= 0)
            {
                <div class="border-t border-gray-100 pt-4">
                    <p class="text-xs text-gray-500 italic">No balance available to withdraw yet.</p>
                </div>
            }
        </div>
    </div>

    <!-- Payout history -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100">
            <h2 class="text-lg font-bold text-gray-900">Withdrawal History</h2>
            <p class="text-xs text-gray-500">Your submitted payout requests.</p>
        </div>

        @if (Model.PayoutHistory != null && Model.PayoutHistory.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-xs uppercase font-semibold text-gray-500 border-b border-gray-200">
                            <th class="px-6 py-3.5">Date</th>
                            <th class="px-6 py-3.5">Reference</th>
                            <th class="px-6 py-3.5">Amount</th>
                            <th class="px-6 py-3.5">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var tx in Model.PayoutHistory)
                        {
                            <tr class="hover:bg-gray-50/80 transition">
                                <td class="px-6 py-4 text-xs text-gray-500 whitespace-nowrap">
                                    @tx.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 font-mono text-xs text-gray-600">
                                    @tx.Reference
                                </td>
                                <td class="px-6 py-4 font-bold text-gray-900 whitespace-nowrap">
                                    @tx.Amount.ToString("C")
                                </td>
                                <td class="px-6 py-4">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold
                                        @(tx.Status == "Approved" ? "bg-emerald-100 text-emerald-800" :
                                          tx.Status == "Rejected" ? "bg-rose-100 text-rose-800" :
                                          tx.Status == "Failed"   ? "bg-rose-100 text-rose-800" :
                                          "bg-amber-100 text-amber-800")">
                                        @tx.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-sm text-gray-500">
                No payout requests submitted yet.
            </div>
        }
    </div>
</div>