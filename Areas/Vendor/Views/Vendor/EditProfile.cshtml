@model Kayane.ViewModels.EditVendorProfileVM

@{
    ViewData["Title"] = "Edit Profile & Bank Details";
}

<div class="max-w-2xl mx-auto px-4 py-8">
    <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-900">Edit Profile & Bank Details</h1>
        <a asp-action="Dashboard" class="text-sm font-medium text-indigo-600 hover:text-indigo-800">&larr; Dashboard</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-sm font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6">
        <form asp-action="EditProfile" method="post" enctype="multipart/form-data" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="VendorId" />

            <div asp-validation-summary="All" class="text-xs font-semibold text-rose-600 bg-rose-50 border border-rose-100 p-3 rounded-xl"></div>

            <!-- Store Info -->
            <div class="space-y-4">
                <h2 class="text-xs font-bold uppercase tracking-wider text-indigo-600 border-b border-gray-100 pb-2">
                    Store Information
                </h2>

                <div>
                    <label asp-for="BusinessName" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Business Name</label>
                    <input asp-for="BusinessName"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="BusinessName" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="BusinessAddress" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Business Address</label>
                    <input asp-for="BusinessAddress"
                           placeholder="Suite 12, Commercial Plaza, Lagos"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="BusinessAddress" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="SupportPhone" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Support Phone</label>
                    <input asp-for="SupportPhone"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="SupportPhone" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="SupportEmail" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Support Email</label>
                    <input asp-for="SupportEmail" type="email"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="SupportEmail" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <!-- Bank Details -->
            <div class="space-y-4 pt-4 border-t border-gray-100">
                <h2 class="text-xs font-bold uppercase tracking-wider text-indigo-600 border-b border-gray-100 pb-2">
                    Payout Bank Details
                </h2>

                <div>
                    <label asp-for="BankName" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Bank Name</label>
                    <input asp-for="BankName" placeholder="e.g. Access Bank, GTBank"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="BankName" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="BankCode" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Bank Code</label>
                    <input asp-for="BankCode" placeholder="e.g. 044 for Access Bank"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="BankCode" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="AccountNumber" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Account Number</label>
                    <input asp-for="AccountNumber" placeholder="10-digit account number" maxlength="10"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="AccountNumber" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="AccountName" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Account Name</label>
                    <input asp-for="AccountName" placeholder="Name on bank account"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="AccountName" class="text-xs text-rose-500 mt-1 block"></span>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                <a asp-action="Dashboard" class="px-5 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit"
                        class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm transition">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>