@model Kayane.Models.Vendor

@{
    ViewData["Title"] = "Edit Profile & Bank Details";
}

<div class="max-w-2xl mx-auto px-4 py-8">
    <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-900">Edit Profile & Bank Details</h1>
        <a href="javascript:history.back()" class="text-sm font-medium text-indigo-600 hover:text-indigo-800">&larr; Back</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 p-4 bg-green-50 border-l-4 border-green-400 text-green-700 rounded-r-lg shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <form asp-action="EditProfile" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="VendorId" />

            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Business Name</label>
                    <input asp-for="BusinessName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Phone Number</label>
                    <input asp-for="BusinessPhone" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2" />
                </div>

                <hr class="my-4 border-gray-200" />
                <h3 class="text-lg font-medium text-gray-900">Payout Bank Details</h3>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Bank Name</label>
                    <input asp-for="BankName" placeholder="e.g. Access Bank, GTBank" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Account Number</label>
                    <input asp-for="AccountNumber" placeholder="10-digit account number" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2" />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">Account Name</label>
                    <input asp-for="AccountName" placeholder="Name on bank account" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border px-3 py-2" />
                </div>
            </div>

            <div class="mt-6 flex justify-end">
                <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-semibold shadow-sm transition">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>