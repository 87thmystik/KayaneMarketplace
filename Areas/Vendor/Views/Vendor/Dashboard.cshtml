@model Kayane.ViewModels.VendorDashboardVM

@{
    ViewData["Title"] = "Vendor Dashboard";
}

<div class="w-full px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <!-- Top Action Bar (Logout) -->
    <div class="flex justify-end">
        <form asp-controller="Auth" asp-action="Logout" asp-area="" method="post" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="px-4 py-2 bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 text-sm font-semibold rounded-xl transition shadow-sm">
                Logout
            </button>
        </form>
    </div>

    <!-- Header -->
    <div class="border-b border-gray-200 pb-6">
        <h1 class="text-3xl font-extrabold text-gray-900">@Model.Vendor.BusinessName Dashboard</h1>
        <p class="text-sm text-gray-500 mt-1">Manage your store products, earnings, and withdrawal requests.</p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-3">
        <a asp-action="Products"
           class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 transition shadow-sm">
            Manage Products
        </a>
        <a asp-action="CreateProduct"
           class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
            + Add Product
        </a>
        <a asp-action="EditProfile"
           class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 transition shadow-sm">
            Edit Store & Bank Details
        </a>
        <a asp-controller="VendorWallet" asp-action="Index"
           class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
            View Wallet & Payouts
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl text-sm font-medium">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-sm font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.PendingOrdersCount > 0)
    {
        <div class="p-4 bg-amber-50 border border-amber-200 text-amber-900 rounded-xl font-medium flex items-center justify-between gap-4">
            <div class="flex items-center gap-2">
                <span class="text-lg">🔔</span>
                <span class="text-sm">
                    You have <strong>@Model.PendingOrdersCount</strong>
                    order item@(Model.PendingOrdersCount == 1 ? "" : "s") awaiting fulfillment.
                </span>
            </div>
            <a asp-action="Orders" asp-route-status="@Kayane.Models.OrderItemStatus.Pending"
               class="px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-lg transition whitespace-nowrap">
                View Orders
            </a>
        </div>
    }

    <!-- Vendor Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Wallet Balance</p>
            <p class="text-3xl font-extrabold text-gray-900 mt-2">₦@(Model.Wallet?.Balance.ToString("N2") ?? "0.00")</p>
            <p class="text-xs text-emerald-600 font-semibold mt-1">Ready for payout</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Lifetime Earnings</p>
            <p class="text-3xl font-extrabold text-gray-900 mt-2">@Model.TotalEarnings.ToString("C")</p>
            <p class="text-xs text-gray-400 mt-1">Gross earnings</p>
        </div>

        <a asp-action="Products"
           class="block bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:border-indigo-400 hover:shadow-md transition">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Store Products</p>
            <p class="text-3xl font-extrabold text-gray-900 mt-2">@Model.TotalProducts</p>
            <p class="text-xs text-amber-600 font-semibold mt-1">@Model.PendingProducts pending</p>
            <span class="inline-block mt-3 text-xs font-semibold text-indigo-600">Manage →</span>
        </a>

        <a asp-action="Orders" asp-route-status="@Kayane.Models.OrderItemStatus.Pending"
           class="block bg-white p-6 rounded-2xl border border-gray-200 shadow-sm hover:border-amber-400 hover:shadow-md transition">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Pending Orders</p>
            <p class="text-3xl font-extrabold text-gray-900 mt-2">@Model.PendingOrdersCount</p>
            <p class="text-xs text-amber-600 font-semibold mt-1">
                @(Model.PendingOrdersCount == 1 ? "item awaiting" : "items awaiting")
            </p>
            <span class="inline-block mt-3 text-xs font-semibold text-amber-600">View orders →</span>
        </a>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Account Status</p>
            <p class="text-2xl font-extrabold text-emerald-600 mt-2">@Model.Vendor.Status</p>
            <p class="text-xs text-gray-400 mt-1">Active vendor</p>
        </div>
    </div>

    <!-- Recent Payout Transactions -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-bold text-gray-900">Recent Payout Requests</h2>
                <p class="text-xs text-gray-500">Your latest withdrawal submissions.</p>
            </div>
            <a asp-controller="VendorWallet" asp-action="Index"
               class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">
                View Full History →
            </a>
        </div>

        @if (Model.RecentTransactions?.Any() == true)
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var tx in Model.RecentTransactions)
                        {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @tx.CreatedAt.ToLocalTime().ToString("g")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">
                                    @tx.Amount.ToString("C")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold
                                        @(tx.Status == "Approved" ? "bg-emerald-100 text-emerald-800" :
                                          tx.Status == "Rejected" ? "bg-rose-100 text-rose-800" :
                                          tx.Status == "Failed" ? "bg-rose-100 text-rose-800" :
                                          "bg-amber-100 text-amber-800")">
                                        @tx.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-sm text-gray-500">
                No payout requests submitted yet.
            </div>
        }
    </div>
</div>