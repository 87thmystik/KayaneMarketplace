@model Kayane.ViewModels.VendorOrderManagementVM
@using Kayane.Models

@{
    ViewData["Title"] = "Order Fulfillment";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Header -->
    <div class="border-b border-gray-200 pb-6">
        <h1 class="text-3xl font-extrabold text-gray-900">Order Fulfillment</h1>
        <p class="text-sm text-gray-500 mt-1">Track and fulfill customer orders.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-xl font-medium">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-700 text-sm rounded-xl font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Status filter tabs -->
    <div class="flex flex-wrap gap-2 border-b border-gray-200 pb-3">
        <a asp-action="Orders"
           class="px-4 py-2 text-xs font-bold rounded-xl transition @(Model.CurrentFilter is null ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
            All Items
        </a>
        <a asp-action="Orders" asp-route-status="@OrderItemStatus.Pending"
           class="px-4 py-2 text-xs font-bold rounded-xl transition flex items-center gap-1.5 @(Model.CurrentFilter == OrderItemStatus.Pending ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
            Pending
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-amber-100 text-amber-800">@Model.PendingCount</span>
        </a>
        <a asp-action="Orders" asp-route-status="@OrderItemStatus.Processing"
           class="px-4 py-2 text-xs font-bold rounded-xl transition flex items-center gap-1.5 @(Model.CurrentFilter == OrderItemStatus.Processing ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
            Processing
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-sky-100 text-sky-800">@Model.ProcessingCount</span>
        </a>
        <a asp-action="Orders" asp-route-status="@OrderItemStatus.Shipped"
           class="px-4 py-2 text-xs font-bold rounded-xl transition flex items-center gap-1.5 @(Model.CurrentFilter == OrderItemStatus.Shipped ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
            Shipped
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-blue-100 text-blue-800">@Model.ShippedCount</span>
        </a>
        <a asp-action="Orders" asp-route-status="@OrderItemStatus.Delivered"
           class="px-4 py-2 text-xs font-bold rounded-xl transition flex items-center gap-1.5 @(Model.CurrentFilter == OrderItemStatus.Delivered ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
            Delivered
            <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-emerald-100 text-emerald-800">@Model.DeliveredCount</span>
        </a>
    </div>

    <!-- Orders table -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        @if (!Model.OrderItems.Any())
        {
            <div class="p-16 text-center space-y-3">
                <div class="text-5xl">📦</div>
                <p class="text-gray-500 text-sm">No order items match this filter.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-[11px] uppercase font-bold text-gray-400 border-b border-gray-200 tracking-wider">
                            <th class="px-6 py-4">Order / Date</th>
                            <th class="px-6 py-4">Product &amp; Customer</th>
                            <th class="px-6 py-4">Qty &amp; Total</th>
                            <th class="px-6 py-4">Status</th>
                            <th class="px-6 py-4">Tracking</th>
                            <th class="px-6 py-4 text-right">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr class="hover:bg-gray-50/80 transition align-top">
                                <td class="px-6 py-4">
                                    <div class="font-mono font-bold text-xs text-gray-900">
                                        #@item.OrderId.ToString().Substring(0, 8)
                                    </div>
                                    <div class="text-xs text-gray-400">
                                        @item.OrderDate.ToString("MMM dd, yyyy HH:mm")
                                    </div>
                                </td>
                                <td class="px-6 py-4 space-y-1">
                                    <div class="font-bold text-gray-900">@item.ProductName</div>
                                    <div class="text-xs text-gray-500">
                                        Customer: <span class="font-semibold text-gray-700">@item.CustomerName</span>
                                    </div>
                                    <div class="text-xs text-gray-400 truncate max-w-xs">
                                        Ship to: @item.ShippingAddress
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-semibold text-gray-800">@item.Quantity unit(s)</div>
                                    <div class="font-extrabold text-emerald-600">
                                        @item.TotalPrice.ToString("C")
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-bold
                                        @(item.Status == OrderItemStatus.Pending ? "bg-amber-100 text-amber-800" :
                                          item.Status == OrderItemStatus.Processing ? "bg-sky-100 text-sky-800" :
                                          item.Status == OrderItemStatus.Shipped ? "bg-blue-100 text-blue-800" :
                                          item.Status == OrderItemStatus.Delivered ? "bg-emerald-100 text-emerald-800" :
                                          "bg-gray-100 text-gray-700")">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-xs">
                                    @if (!string.IsNullOrEmpty(item.TrackingNumber))
                                    {
                                        <div class="text-gray-700">
                                            <span class="font-bold">Carrier:</span> @item.ShippingCarrier
                                        </div>
                                        <div class="text-gray-700 font-mono">
                                            <span class="font-bold">Track#:</span> @item.TrackingNumber
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 italic">Not yet shipped</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    @if (item.Status == OrderItemStatus.Pending)
                                    {
                                        <div class="flex items-center justify-end gap-2">
                                            <form asp-action="UpdateOrderItemStatus" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderItemId" value="@item.OrderItemId" />
                                                <input type="hidden" name="newStatus" value="@OrderItemStatus.Processing" />
                                                <button type="submit"
                                                        class="px-3 py-1.5 bg-sky-600 hover:bg-sky-700 text-white text-xs font-semibold rounded-lg transition shadow-sm whitespace-nowrap">
                                                    Start Processing
                                                </button>
                                            </form>
                                            <button type="button"
                                                    onclick="window.dispatchEvent(new CustomEvent('open-vendor-cancel-modal', { detail: { id: '@item.OrderItemId', product: @System.Text.Json.JsonSerializer.Serialize(item.ProductName) } }))"
                                                    class="px-3 py-1.5 bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 text-xs font-semibold rounded-lg transition whitespace-nowrap">
                                                Cancel
                                            </button>
                                        </div>
                                    }
                                    else if (item.Status == OrderItemStatus.Processing)
                                    {
                                        <button type="button"
                                                onclick="window.dispatchEvent(new CustomEvent('open-ship-modal', { detail: { id: '@item.OrderItemId', product: @System.Text.Json.JsonSerializer.Serialize(item.ProductName) } }))"
                                                class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-lg transition shadow-sm whitespace-nowrap">
                                            Mark as Shipped
                                        </button>
                                    }
                                    else if (item.Status == OrderItemStatus.Shipped)
                                    {
                                        <form asp-action="UpdateOrderItemStatus" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderItemId" value="@item.OrderItemId" />
                                            <input type="hidden" name="newStatus" value="@OrderItemStatus.Delivered" />
                                            <button type="submit"
                                                    class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold rounded-lg transition shadow-sm whitespace-nowrap">
                                                Mark as Delivered
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == OrderItemStatus.Delivered)
                                    {
                                        <span class="text-emerald-600 text-xs font-bold flex items-center justify-end gap-1">
                                            ✓ Fulfilled
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ==================================================================
     Modals — both siblings at the bottom, NOT nested inside each other
     ================================================================== -->
<!-- Ship modal -->
<div x-data="{ open: false, orderItemId: '', productName: '' }"
    @@open-ship-modal.window="open = true; orderItemId = $event.detail.id; productName = $event.detail.product"
     x-show="open"
     x-cloak
     class="fixed inset-0 z-50 flex items-center justify-center p-4">

    <div class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm" @@click="open = false"></div>

    <div class="relative bg-white rounded-2xl shadow-xl max-w-md w-full p-6 space-y-5">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h3 class="text-lg font-bold text-gray-900">Ship Item</h3>
                <p class="text-xs text-gray-500 mt-0.5" x-text="'For: ' + productName"></p>
            </div>
            <button type="button" @@click="open = false"
                    class="text-gray-400 hover:text-gray-700 text-xl leading-none">
                &times;
            </button>
        </div>

        <form asp-action="UpdateOrderItemStatus" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="orderItemId" :value="orderItemId" />
            <input type="hidden" name="newStatus" value="@OrderItemStatus.Shipped" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Shipping Carrier</label>
                <input type="text" name="shippingCarrier" required
                       placeholder="e.g. DHL, FedEx, GIG Logistics"
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tracking Number</label>
                <input type="text" name="trackingNumber" required
                       placeholder="e.g. TRK-9847294"
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            </div>

            <div class="flex justify-end gap-2 pt-2 border-t border-gray-100">
                <button type="button" @@click="open = false"
                        class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-xl transition">
                    Cancel
                </button>
                <button type="submit"
                        class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition shadow-sm">
                    Confirm &amp; Ship
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Vendor cancel-item modal — SIBLING of the ship modal, not nested -->
<div x-data="{ open: false, orderItemId: '', productName: '' }"
    @@open-vendor-cancel-modal.window="open = true; orderItemId = $event.detail.id; productName = $event.detail.product"
     x-show="open"
     x-cloak
     class="fixed inset-0 z-50 flex items-center justify-center p-4">

    <div class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm" @@click="open = false"></div>

    <div class="relative bg-white rounded-2xl shadow-xl max-w-md w-full p-6 space-y-5">
        <div class="flex items-start justify-between gap-4">
            <div>
                <h3 class="text-lg font-bold text-gray-900">Cancel Item</h3>
                <p class="text-xs text-gray-500 mt-0.5" x-text="'For: ' + productName"></p>
            </div>
            <button type="button" @@click="open = false"
                    class="text-gray-400 hover:text-gray-700 text-xl leading-none">
                &times;
            </button>
        </div>

        <form asp-action="CancelOrderItem" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="OrderItemId" :value="orderItemId" />

            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Reason</label>
                <textarea name="Reason" rows="3" required minlength="3" maxlength="500"
                          placeholder="e.g. Out of stock, unable to fulfill..."
                          class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-rose-500 focus:outline-none"></textarea>
            </div>

            <div class="flex justify-end gap-2 pt-2 border-t border-gray-100">
                <button type="button" @@click="open = false"
                        class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-xl transition">
                    Keep It
                </button>
                <button type="submit"
                        onclick="return confirm('Cancel this item? Stock will be restored and the buyer refunded.')"
                        class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold rounded-xl transition shadow-sm">
                    Confirm Cancellation
                </button>
            </div>
        </form>
    </div>
</div>