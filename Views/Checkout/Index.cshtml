@model Kayane.ViewModels.CheckoutVM

@{
    ViewData["Title"] = "Checkout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="border-b border-gray-200 pb-4">
        <h1 class="text-3xl font-bold text-gray-900">Checkout</h1>
        <p class="text-sm text-gray-500 mt-1">Complete your order details and payment selection.</p>
    </div>

    <form asp-action="Process" method="post">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- LEFT: Shipping + Payment -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Shipping -->
                <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6"
                     x-data="{ usingSaved: @(Model.SelectedAddressId.HasValue ? "true" : "false") }">

                    <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3">Shipping Details</h2>

                    <!-- Email (always visible) -->
                    <div>
                        <label asp-for="CustomerEmail" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Email Address</label>
                        <input asp-for="CustomerEmail" type="email" placeholder="john@example.com"
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        <span asp-validation-for="CustomerEmail" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    @if (Model.SavedAddresses.Any())
                    {
                        <div class="space-y-3">
                            <p class="text-xs font-bold uppercase tracking-wider text-gray-700">Deliver To</p>

                            @foreach (var addr in Model.SavedAddresses)
                            {
                                var addrIdStr = addr.AddressId.ToString();
                                <label class="flex items-start gap-3 p-4 border-2 rounded-xl cursor-pointer transition"
                                       :class="usingSaved ? 'border-gray-200 hover:border-indigo-300' : 'border-gray-200 hover:border-indigo-300'">
                                    <input type="radio" name="SelectedAddressId" value="@addrIdStr"
                                           checked="@(Model.SelectedAddressId == addr.AddressId)"
                                           @@change="usingSaved = true"
                                           class="mt-1 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300" />
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="font-bold text-gray-900 text-sm">@addr.Label</span>
                                            @if (addr.IsDefault)
                                            {
                                                <span class="px-2 py-0.5 bg-indigo-100 text-indigo-700 text-[10px] font-bold uppercase tracking-wider rounded-full">Default</span>
                                            }
                                        </div>
                                        <p class="text-sm text-gray-800 mt-1">@addr.RecipientName</p>
                                        <p class="text-xs text-gray-500">@addr.Phone</p>
                                        <p class="text-sm text-gray-600 mt-1">@addr.FullAddress</p>
                                    </div>
                                </label>
                            }

                            <label class="flex items-center gap-3 p-4 border-2 rounded-xl cursor-pointer transition border-gray-200 hover:border-indigo-300">
                                <input type="radio" name="SelectedAddressId" value=""
                                       checked="@(!Model.SelectedAddressId.HasValue)"
                                       @@change="usingSaved = false"
                                       class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300" />
                                <span class="font-semibold text-gray-800 text-sm">Use a new address</span>
                            </label>
                        </div>
                    }

                    <!-- Manual entry — hidden when a saved address is in use -->
                    <div x-show="!usingSaved || @(Model.SavedAddresses.Any() ? "false" : "true")" x-cloak
                         class="space-y-5 border-t border-gray-100 pt-5">

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label asp-for="CustomerName" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Full Name</label>
                                <input asp-for="CustomerName" placeholder="John Doe"
                                       class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                                <span asp-validation-for="CustomerName" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>
                            <div>
                                <label asp-for="CustomerPhone" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Phone Number</label>
                                <input asp-for="CustomerPhone" placeholder="+234..."
                                       class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                                <span asp-validation-for="CustomerPhone" class="text-xs text-rose-500 mt-1 block"></span>
                            </div>
                        </div>

                        <div>
                            <label asp-for="ShippingAddress" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1">Delivery Address</label>
                            <textarea asp-for="ShippingAddress" rows="3" placeholder="Street, city, state..."
                                      class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
                            <span asp-validation-for="ShippingAddress" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        @if (Model.SavedAddresses.Any())
                        {
                            <label class="flex items-center gap-2">
                                <input asp-for="SaveNewAddress" type="checkbox"
                                       class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" />
                                <span class="text-sm text-gray-700">Save this address to my account</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="bg-white border border-gray-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
                    <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3">Payment Method</h2>

                    <div class="space-y-3">
                        <label class="flex items-center p-4 border border-gray-200 rounded-xl cursor-pointer hover:border-indigo-500 transition">
                            <input type="radio" asp-for="SelectedPaymentMethod" value="Paystack"
                                   class="text-indigo-600 focus:ring-indigo-500 h-4 w-4" checked />
                            <div class="ml-3">
                                <span class="block text-sm font-bold text-gray-900">Paystack (Card, Transfer, USSD)</span>
                                <span class="block text-xs text-gray-500">Secure online payment via Paystack gateway.</span>
                            </div>
                        </label>

                        <label class="flex items-center p-4 border border-gray-200 rounded-xl cursor-pointer hover:border-indigo-500 transition">
                            <input type="radio" asp-for="SelectedPaymentMethod" value="CashOnDelivery"
                                   class="text-indigo-600 focus:ring-indigo-500 h-4 w-4" />
                            <div class="ml-3">
                                <span class="block text-sm font-bold text-gray-900">Cash on Delivery</span>
                                <span class="block text-xs text-gray-500">Pay with cash upon package arrival.</span>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Order Summary -->
            <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm h-fit space-y-6">
                <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3">Order Summary</h2>

                <div class="divide-y divide-gray-100 max-h-60 overflow-y-auto space-y-3 pr-1">
                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="flex items-center justify-between pt-3 text-sm">
                            <div>
                                <p class="font-bold text-gray-900">@item.Name</p>
                                <p class="text-xs text-gray-500">Qty: @item.Quantity × @item.Price.ToString("C")</p>
                            </div>
                            <span class="font-semibold text-gray-900">@item.Total.ToString("C")</span>
                        </div>
                    }
                </div>

                <div class="border-t border-gray-100 pt-4 space-y-2 text-sm text-gray-600">
                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span class="font-semibold text-gray-900">@Model.Cart.GrandTotal.ToString("C")</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Shipping Fee</span>
                        <span class="text-emerald-600 font-medium">Free</span>
                    </div>
                    <div class="border-t border-gray-100 pt-3 flex justify-between text-base font-bold text-gray-900">
                        <span>Total Due</span>
                        <span class="text-indigo-600">@Model.Cart.GrandTotal.ToString("C")</span>
                    </div>
                </div>

                <button type="submit"
                        class="w-full py-3.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition shadow-sm">
                    Place Order
                </button>
            </div>
        </div>
    </form>
</div>