@model Kayane.ViewModels.VendorOrderManagementVM
@{
    ViewData["Title"] = "Manage Vendor Orders";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-gray-200 pb-6">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Order Fulfillment</h1>
            <p class="text-sm text-gray-500">Track customer orders, update delivery status, and manage shipping information.</p>
        </div>

        <!-- Status Filter Tabs -->
        <div class="flex flex-wrap gap-2">
            <a asp-action="Index" class="px-4 py-2 text-xs font-bold rounded-xl transition @(!Model.CurrentFilter.HasValue ? "bg-indigo-600 text-white shadow-sm" : "bg-white text-gray-600 border border-gray-200 hover:bg-gray-50")">
                All
            </a>
            <a asp-action="Index" asp-route-status="0" class="px-4 py-2 text-xs font-bold rounded-xl transition @(Model.CurrentFilter == Kayane.Models.OrderItemStatus.Pending ? "bg-amber-600 text-white shadow-sm" : "bg-white text-gray-600 border border-gray-200 hover:bg-gray-50")">
                Pending (@Model.PendingCount)
            </a>
            <a asp-action="Index" asp-route-status="1" class="px-4 py-2 text-xs font-bold rounded-xl transition @(Model.CurrentFilter == Kayane.Models.OrderItemStatus.Processing ? "bg-blue-600 text-white shadow-sm" : "bg-white text-gray-600 border border-gray-200 hover:bg-gray-50")">
                Processing (@Model.ProcessingCount)
            </a>
            <a asp-action="Index" asp-route-status="2" class="px-4 py-2 text-xs font-bold rounded-xl transition @(Model.CurrentFilter == Kayane.Models.OrderItemStatus.Shipped ? "bg-indigo-600 text-white shadow-sm" : "bg-white text-gray-600 border border-gray-200 hover:bg-gray-50")">
                Shipped (@Model.ShippedCount)
            </a>
            <a asp-action="Index" asp-route-status="3" class="px-4 py-2 text-xs font-bold rounded-xl transition @(Model.CurrentFilter == Kayane.Models.OrderItemStatus.Delivered ? "bg-emerald-600 text-white shadow-sm" : "bg-white text-gray-600 border border-gray-200 hover:bg-gray-50")">
                Delivered (@Model.DeliveredCount)
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-xl font-medium shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-700 text-sm rounded-xl font-medium shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.OrderItems.Any())
    {
        <div class="bg-white rounded-2xl border border-gray-200 p-16 text-center space-y-3 shadow-sm">
            <p class="text-gray-500 text-sm">No order items match the selected filter criteria.</p>
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-[11px] uppercase font-bold text-gray-400 border-b border-gray-200">
                            <th class="px-6 py-4">Order / Date</th>
                            <th class="px-6 py-4">Product & Customer</th>
                            <th class="px-6 py-4">Qty & Total</th>
                            <th class="px-6 py-4">Current Status</th>
                            <th class="px-6 py-4 text-right">Update Fulfillment</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr class="hover:bg-gray-50/50 transition align-top">
                                <td class="px-6 py-4">
                                    <div class="font-mono font-bold text-xs text-gray-900">#@item.OrderId.ToString().Substring(0, 8)</div>
                                    <div class="text-xs text-gray-400">@item.OrderDate.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td class="px-6 py-4 space-y-1">
                                    <div class="font-bold text-gray-900">@item.ProductName</div>
                                    <div class="text-xs text-gray-500">Customer: <span class="font-semibold text-gray-700">@item.CustomerName</span></div>
                                    <div class="text-xs text-gray-400 truncate max-w-xs">Ship to: @item.ShippingAddress</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-semibold text-gray-800">@item.Quantity unit(s)</div>
                                    <div class="font-extrabold text-emerald-600">&#8358;@item.TotalPrice.ToString("N2")</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-bold
                                        @(item.Status == OrderItemStatus.Pending ? "bg-amber-100 text-amber-800" :
                                          item.Status == OrderItemStatus.Processing ? "bg-blue-100 text-blue-800" :
                                          item.Status == OrderItemStatus.Shipped ? "bg-indigo-100 text-indigo-800" : "bg-emerald-100 text-emerald-800")">
                                        @item.Status
                                    </span>
                                    @if (!string.IsNullOrEmpty(item.TrackingNumber))
                                    {
                                        <div class="text-[11px] text-gray-500 mt-1">Carrier: @item.ShippingCarrier</div>
                                        <div class="text-[11px] font-mono text-gray-600">Track: @item.TrackingNumber</div>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <form asp-action="UpdateOrderItemStatus" method="post" class="space-y-2 inline-block text-left">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderItemId" value="@item.OrderItemId" />

                                        <div class="flex gap-2">
                                            <select name="newStatus" class="text-xs border border-gray-300 rounded-lg px-2 py-1 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                                                @foreach (var statusOption in Enum.GetValues<OrderItemStatus>())
                                                {
                                                    <option value="@((int)statusOption)" selected="@(item.Status == statusOption)">@statusOption</option>
                                                }
                                            </select>
                                            <button type="submit" class="px-3 py-1 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg transition shadow-sm">
                                                Save
                                            </button>
                                        </div>

                                        <div class="flex gap-1">
                                            <input type="text" name="shippingCarrier" placeholder="Carrier" value="@item.ShippingCarrier" class="w-24 text-[11px] border border-gray-300 rounded px-1.5 py-0.5" />
                                            <input type="text" name="trackingNumber" placeholder="Tracking #" value="@item.TrackingNumber" class="w-28 text-[11px] border border-gray-300 rounded px-1.5 py-0.5" />
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>