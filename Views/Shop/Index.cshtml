@model Kayane.ViewModels.ShopCatalogVM

@{
    ViewData["Title"] = "Shop - Kayane Marketplace";

    string BuildPageUrl(int targetPage)
    {
        var parts = new List<string> { $"page={targetPage}" };
        if (Model.SelectedCategoryId.HasValue)
            parts.Add($"categoryId={Model.SelectedCategoryId}");
        if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
            parts.Add($"search={Uri.EscapeDataString(Model.SearchQuery)}");
        return "/Shop?" + string.Join("&", parts);
    }
}

<div class="space-y-8 py-8">
    <!-- Hero -->
    <div class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 text-white rounded-3xl p-12 md:p-16">
        <div class="max-w-2xl">
            <h1 class="text-4xl md:text-5xl font-black mb-4">Explore Our Marketplace</h1>
            <p class="text-lg text-indigo-100">Discover quality products from verified vendors.</p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Search -->
        <form asp-action="Index" method="get" class="flex flex-col md:flex-row gap-4 mb-8">
            @if (Model.SelectedCategoryId.HasValue)
            {
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
            }
            <div class="flex-1">
                <label class="block text-sm font-semibold text-gray-700 mb-2">Search Products</label>
                <input type="text" name="search" value="@Model.SearchQuery"
                       placeholder="Search by name or description..."
                       class="w-full px-5 py-3 border-2 border-gray-300 rounded-xl text-base focus:ring-2 focus:ring-indigo-500 focus:outline-none focus:border-indigo-500 transition" />
            </div>
            <div class="flex items-end gap-2">
                <button type="submit"
                        class="px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition shadow-md hover:shadow-lg whitespace-nowrap">
                    Search
                </button>
                <a asp-action="Index"
                   class="px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold rounded-xl transition whitespace-nowrap">
                    Clear
                </a>
            </div>
        </form>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            <!-- Sidebar -->
            <aside class="space-y-6">
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <span class="text-xl">📂</span> Categories
                    </h3>
                    <div class="space-y-1 bg-white p-3 rounded-2xl border-2 border-gray-100">
                        <a asp-action="Index" asp-route-search="@Model.SearchQuery"
                           class="block px-4 py-2.5 rounded-lg text-sm font-medium transition @(!Model.SelectedCategoryId.HasValue ? "bg-indigo-50 text-indigo-700" : "text-gray-700 hover:bg-gray-100")">
                            All Categories
                        </a>
                        @foreach (var cat in Model.Categories)
                        {
                            <a asp-action="Index" asp-route-categoryId="@cat.CategoryId" asp-route-search="@Model.SearchQuery"
                               class="block px-4 py-2.5 rounded-lg text-sm font-medium transition @(Model.SelectedCategoryId == cat.CategoryId ? "bg-indigo-50 text-indigo-700" : "text-gray-700 hover:bg-gray-100")">
                                @cat.Name
                            </a>
                        }
                    </div>
                </div>
            </aside>

            <!-- Products -->
            <main class="lg:col-span-3">
                @if (!Model.Products.Any())
                {
                    <div class="py-16 text-center bg-white border-2 border-gray-100 rounded-2xl">
                        <div class="text-6xl mb-4">🔍</div>
                        <p class="text-xl font-bold text-gray-900 mb-2">No products found</p>
                        <p class="text-gray-600 mb-6">Try adjusting your search or browse a different category</p>
                        <a asp-action="Index"
                           class="inline-block px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition">
                            Browse All Products
                        </a>
                    </div>
                }
                else
                {
                    <div class="flex justify-between items-center mb-6">
                        <p class="text-gray-600 text-sm">
                            <span class="font-bold text-lg text-gray-900">@Model.TotalProducts</span> product@(Model.TotalProducts == 1 ? "" : "s") found
                        </p>
                        @if (Model.TotalPages > 1)
                        {
                            <p class="text-xs text-gray-400">
                                Page @Model.CurrentPage of @Model.TotalPages
                            </p>
                        }
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        @foreach (var product in Model.Products)
                        {
                            var hasReviews = product.ReviewCount > 0;
                            var fullStars = hasReviews ? (int)Math.Floor(product.AverageRating) : 0;
                            var hasHalf = hasReviews && (product.AverageRating - fullStars) >= 0.5;

                            <div class="group bg-white border-2 border-gray-100 rounded-2xl shadow-md hover:shadow-xl hover:border-indigo-300 overflow-hidden transition-all flex flex-col justify-between hover:scale-[1.02]">

                                <!-- Image -->
                                <a asp-controller="Storefront" asp-action="Details" asp-route-id="@product.ProductId"
                                   class="relative h-48 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center overflow-hidden block">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name"
                                             class="w-full h-full object-cover group-hover:scale-110 transition duration-300" />
                                    }
                                    else
                                    {
                                        <div class="text-6xl">📦</div>
                                    }

                                    @if (product.OutOfStock)
                                    {
                                        <div class="absolute top-3 left-3 bg-gray-900/80 text-white px-3 py-1 rounded-full text-xs font-bold">
                                            Out of Stock
                                        </div>
                                    }
                                    else if (product.IsNewArrival)
                                    {
                                        <div class="absolute top-3 left-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-3 py-1 rounded-full text-xs font-bold">
                                            New
                                        </div>
                                    }
                                </a>

                                <div class="p-5 flex flex-col grow">
                                    <span class="text-xs font-bold text-indigo-600 uppercase tracking-wide mb-2">
                                        🏪 @product.VendorName
                                    </span>

                                    <a asp-controller="Storefront" asp-action="Details" asp-route-id="@product.ProductId"
                                       class="text-lg font-bold text-gray-900 group-hover:text-indigo-600 transition line-clamp-2 mb-2">
                                        @product.Name
                                    </a>

                                    <p class="text-sm text-gray-600 line-clamp-2 mb-4 grow">@product.Description</p>

                                    <!-- Real rating -->
                                    <div class="flex items-center gap-2 mb-4 text-sm">
                                        @if (hasReviews)
                                        {
                                            <div class="flex text-yellow-400 text-base leading-none">
                                                @for (int i = 0; i < fullStars; i++) { <span>★</span> }
                                                @if (hasHalf) { <span>⯨</span> }
                                                @for (int i = fullStars + (hasHalf ? 1 : 0); i < 5; i++) { <span class="text-gray-300">★</span> }
                                            </div>
                                            <span class="text-gray-600">
                                                @product.AverageRating.ToString("F1")
                                                <span class="text-gray-400">(@product.ReviewCount)</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400 italic">No reviews yet</span>
                                        }
                                    </div>

                                    <!-- Price + actions -->
                                    <div class="border-t border-gray-100 pt-4 flex items-center justify-between">
                                         <div>
        <p class="text-xs text-gray-500 mb-1">Price</p>
        <span class="text-2xl font-black text-indigo-600">@product.Price.ToString("C")</span>
    </div>

    <div class="flex items-center gap-2">
        <a asp-controller="Storefront" asp-action="Details" asp-route-id="@product.ProductId"
           class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-xl transition">
            View
        </a>

        @if (!product.OutOfStock)
        {
            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@product.ProductId" />
                <input type="hidden" name="quantity" value="1" />
                <button type="submit"
                        title="Add to cart"
                        class="p-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl transition shadow-md hover:shadow-lg">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                </button>
            </form>
        }
        else
        {
            <span class="px-3 py-2 bg-gray-100 text-gray-400 text-xs font-semibold rounded-xl">
                Unavailable
            </span>
        }
    </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <div class="flex justify-center items-center gap-2 mt-10">
                            @if (Model.HasPreviousPage)
                            {
                                <a href="@BuildPageUrl(Model.CurrentPage - 1)"
                                   class="px-4 py-2 bg-white border border-gray-300 hover:border-gray-400 text-sm font-semibold text-gray-700 rounded-xl transition">
                                    ← Previous
                                </a>
                            }
                            else
                            {
                                <span class="px-4 py-2 bg-gray-50 border border-gray-200 text-sm font-semibold text-gray-300 rounded-xl cursor-not-allowed">
                                    ← Previous
                                </span>
                            }

                            @{
                                int start = Math.Max(1, Model.CurrentPage - 2);
                                int end = Math.Min(Model.TotalPages, start + 4);
                                start = Math.Max(1, end - 4);
                            }

                            @for (int i = start; i <= end; i++)
                            {
                                if (i == Model.CurrentPage)
                                {
                                    <span class="px-4 py-2 bg-indigo-600 text-white text-sm font-bold rounded-xl shadow-sm">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a href="@BuildPageUrl(i)"
                                       class="px-4 py-2 bg-white border border-gray-300 hover:border-indigo-400 hover:text-indigo-600 text-sm font-semibold text-gray-700 rounded-xl transition">
                                        @i
                                    </a>
                                }
                            }

                            @if (Model.HasNextPage)
                            {
                                <a href="@BuildPageUrl(Model.CurrentPage + 1)"
                                   class="px-4 py-2 bg-white border border-gray-300 hover:border-gray-400 text-sm font-semibold text-gray-700 rounded-xl transition">
                                    Next →
                                </a>
                            }
                            else
                            {
                                <span class="px-4 py-2 bg-gray-50 border border-gray-200 text-sm font-semibold text-gray-300 rounded-xl cursor-not-allowed">
                                    Next →
                                </span>
                            }
                        </div>
                    }
                }
            </main>
        </div>
    </div>
</div>