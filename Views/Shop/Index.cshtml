@model Kayane.ViewModels.ShopCatalogVM

@{
    ViewData["Title"] = "Shop - Kayane Marketplace";
}

<div class="space-y-8 py-8">
    <!-- Hero Section -->
    <div class="bg-linear-to-r from-indigo-600 via-purple-600 to-pink-600 text-white rounded-3xl p-12 md:p-16">
        <div class="max-w-2xl">
            <h1 class="text-4xl md:text-5xl font-black mb-4">Explore Our Marketplace</h1>
            <p class="text-lg text-indigo-100">Discover thousands of quality products from verified vendors. Find what you're looking for with ease.</p>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Search & Filters Header -->
        <div class="space-y-6 mb-8">
            <form asp-action="Index" method="get" class="flex flex-col md:flex-row gap-4">
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                <div class="flex-1">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Search Products</label>
                    <input type="text" name="search" value="@Model.SearchQuery" placeholder="Search by name, description, or vendor..."
                           class="w-full px-5 py-3 border-2 border-gray-300 rounded-xl text-base focus:ring-2 focus:ring-indigo-500 focus:outline-none focus:border-indigo-500 transition" />
                </div>
                <div class="flex items-end gap-2">
                    <button type="submit" class="px-8 py-3 bg-linear-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold rounded-xl transition shadow-md hover:shadow-lg whitespace-nowrap">
                        Search
                    </button>
                    <a asp-action="Index" class="px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold rounded-xl transition whitespace-nowrap">
                        Clear
                    </a>
                </div>
            </form>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            <!-- Sidebar Categories -->
            <aside class="space-y-6">
                <div>
                    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <span class="text-xl">📂</span> Categories
                    </h3>
                    <div class="space-y-2 bg-white p-4 rounded-2xl border-2 border-gray-100">
                        <a asp-action="Index" asp-route-search="@Model.SearchQuery"
                           class="block px-4 py-3 rounded-lg text-base font-medium transition @(!Model.SelectedCategoryId.HasValue ? "bg-gradient-to-r from-indigo-100 to-purple-100 text-indigo-700 border-l-4 border-indigo-600" : "text-gray-700 hover:bg-gray-100")">
                            All Categories
                        </a>
                        @foreach (var cat in Model.Categories)
                        {
                            <a asp-action="Index" asp-route-categoryId="@cat.CategoryId" asp-route-search="@Model.SearchQuery"
                               class="block px-4 py-3 rounded-lg text-base font-medium transition @(Model.SelectedCategoryId == cat.CategoryId ? "bg-gradient-to-r from-indigo-100 to-purple-100 text-indigo-700 border-l-4 border-indigo-600" : "text-gray-700 hover:bg-gray-100")">
                                @cat.Name
                            </a>
                        }
                    </div>
                </div>

                <!-- Filter Info Card -->
                <div class="bg-linear-to-br from-indigo-50 to-purple-50 p-6 rounded-2xl border-2 border-indigo-100">
                    <h4 class="font-bold text-gray-900 mb-2">Pro Tips</h4>
                    <ul class="text-sm space-y-2 text-gray-700">
                        <li class="flex items-start gap-2">
                            <span class="text-lg">✨</span>
                            <span>Use filters to narrow results</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-lg">🔍</span>
                            <span>Check vendor ratings</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <span class="text-lg">📦</span>
                            <span>Read product reviews</span>
                        </li>
                    </ul>
                </div>
            </aside>

            <!-- Product Grid -->
            <main class="lg:col-span-3">
                @if (Model.Products.Any())
                {
                    <div class="flex justify-between items-center mb-6">
                        <p class="text-gray-600">
                            <span class="font-bold text-lg text-gray-900">@Model.Products.Count()</span> products found
                        </p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        @foreach (var product in Model.Products)
                        {
                            <div class="group bg-white border-2 border-gray-100 rounded-2xl shadow-md hover:shadow-xl hover:border-indigo-300 overflow-hidden transition-all flex flex-col justify-between hover:scale-105">

                                <!-- Product Image (links to detail) -->
                                <a asp-controller="Storefront" asp-action="Details" asp-route-id="@product.ProductId"
                                   class="relative h-48 bg-linear-to-br from-gray-100 to-gray-200 group-hover:from-indigo-100 group-hover:to-purple-100 transition flex items-center justify-center overflow-hidden block">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl" alt="@product.Name" class="w-full h-full object-cover group-hover:scale-110 transition duration-300" />
                                    }
                                    else
                                    {
                                        <div class="text-6xl">📦</div>
                                    }
                                    <div class="absolute top-3 right-3 bg-linear-to-r from-indigo-600 to-purple-600 text-white px-3 py-1 rounded-full text-xs font-bold">
                                        New
                                    </div>
                                </a>

                                <div class="p-5 flex flex-col grow">
                                    <!-- Vendor Info -->
                                    <span class="text-xs font-bold text-indigo-600 uppercase tracking-wide mb-2">
                                        🏪 @(product.Vendor?.BusinessName ?? "Kayane Partner")
                                    </span>

                                    <!-- Product Name (links to detail) -->
                                    <a asp-controller="Storefront" asp-action="Details" asp-route-id="@product.ProductId"
                                       class="text-lg font-bold text-gray-900 group-hover:text-indigo-600 transition line-clamp-2 mb-2">
                                        @product.Name
                                    </a>

                                    <!-- Product Description -->
                                    <p class="text-sm text-gray-600 line-clamp-2 mb-4 grow">@product.Description</p>

                                    <!-- Rating -->
                                    <div class="flex items-center gap-2 mb-4 text-sm">
                                        <div class="flex text-yellow-400">★★★★★</div>
                                        <span class="text-gray-600">(24)</span>
                                    </div>

                                    <!-- Price & Action -->
                                    <div class="border-t border-gray-100 pt-4 flex items-center justify-between">
                                        <div>
                                            <p class="text-xs text-gray-500 mb-1">Price</p>
                                            <span class="text-2xl font-black text-indigo-600">$@product.Price.ToString("F2")</span>
                                        </div>

                                        <div class="flex items-center gap-2">
                                            <a asp-controller="Storefront" asp-action="Details" asp-route-id="@product.ProductId"
                                               class="px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-xl transition">
                                                View
                                            </a>
                                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="flex items-center">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@product.ProductId" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="p-3 bg-linear-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white rounded-xl transition shadow-md hover:shadow-lg group-hover:scale-110 duration-300">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="py-16 text-center bg-white border-2 border-gray-100 rounded-2xl">
                        <div class="text-6xl mb-4">🔍</div>
                        <p class="text-xl font-bold text-gray-900 mb-2">No products found</p>
                        <p class="text-gray-600 mb-6">Try adjusting your search or browse a different category</p>
                        <a asp-action="Index" class="inline-block px-6 py-3 bg-linear-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-semibold rounded-xl transition">
                            Browse All Products
                        </a>
                    </div>
                }
            </main>
        </div>
    </div>
</div>