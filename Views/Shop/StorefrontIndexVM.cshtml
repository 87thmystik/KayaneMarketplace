@model Kayane.ViewModels.StorefrontIndexVM
@{
    ViewData["Title"] = "Marketplace Storefront";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <!-- Header & Search Bar -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-gray-200 pb-6">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">Explore Marketplace</h1>
            <p class="text-sm text-gray-500">Discover verified products from our multi-vendor ecosystem.</p>
        </div>
        
        <form asp-action="Index" method="get" class="flex gap-2 w-full md:w-96">
            <input type="text" name="searchString" value="@Model.SearchString" placeholder="Search products..." 
                   class="w-full px-4 py-2 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
            <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition shadow-sm">
                Search
            </button>
        </form>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar Category Filters -->
        <div class="space-y-4">
            <h2 class="text-sm font-bold uppercase tracking-wider text-gray-400">Categories</h2>
            <div class="bg-white rounded-2xl border border-gray-200 p-4 shadow-sm space-y-1">
                <a asp-action="Index" class="block px-4 py-2 text-sm font-semibold rounded-xl transition @(!Model.SelectedCategory.HasValue ? "bg-indigo-50 text-indigo-600" : "text-gray-600 hover:bg-gray-50")">
                    All Categories
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-action="Index" asp-route-categoryId="@cat.CategoryId" 
                       class="block px-4 py-2 text-sm font-semibold rounded-xl transition @(Model.SelectedCategory == cat.CategoryId ? "bg-indigo-50 text-indigo-600" : "text-gray-600 hover:bg-gray-50")">
                        @cat.Name
                    </a>
                }
            </div>
        </div>

        <!-- Product Grid -->
        <div class="lg:col-span-3">
            @if (!Model.Products.Any())
            {
                <div class="bg-white rounded-2xl border border-gray-200 p-16 text-center space-y-3">
                    <p class="text-gray-500 text-sm">No products found matching your criteria.</p>
                    <a asp-action="Index" class="inline-block px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition">
                        Reset Filters
                    </a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var p in Model.Products)
                    {
                        <div class="bg-white rounded-2xl border border-gray-200 p-5 shadow-sm flex flex-col justify-between space-y-4 hover:shadow-md transition">
                            <div class="space-y-2">
                                <div class="flex items-center justify-between">
                                    <span class="text-[10px] uppercase font-bold tracking-wider px-2.5 py-1 bg-gray-100 text-gray-600 rounded-full">@p.CategoryName</span>
                                    <span class="text-xs text-gray-400 font-medium">By @p.VendorName</span>
                                </div>
                                <h3 class="font-bold text-gray-900 text-base leading-snug">@p.Name</h3>
                                <p class="text-xs text-gray-500 line-clamp-2">@p.Description</p>
                            </div>

                            <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                                <div class="text-lg font-extrabold text-emerald-600">&#8358;@p.Price.ToString("N2")</div>
                                <a asp-action="Details" asp-route-id="@p.ProductId" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition shadow-sm">
                                    View Details
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>