@model Kayane.ViewModels.CancelOrderVM

@{
    ViewData["Title"] = "Cancel Order";
}

<div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="border-b border-gray-200 pb-4 mb-6">
        <h1 class="text-2xl font-extrabold text-gray-900">Cancel Order #@Model.ShortOrderId</h1>
        <p class="text-sm text-gray-500 mt-1">Tell us why you're cancelling. This helps us improve.</p>
    </div>

    <div class="p-4 bg-amber-50 border border-amber-200 text-amber-800 rounded-xl text-sm mb-6">
        <strong>Note:</strong> Once cancelled, this order cannot be restored. If payment was taken, a refund will be processed.
    </div>

    <form asp-action="Cancel" method="post" class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="OrderId" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 font-medium"></div>

        <div>
            <label asp-for="Reason" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Reason for Cancellation</label>
            <textarea asp-for="Reason" rows="4" required minlength="3" maxlength="500"
                      placeholder="e.g. Ordered by mistake, found a better price, wrong address..."
                      class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
            <span asp-validation-for="Reason" class="text-xs text-rose-500 mt-1 block"></span>
        </div>

        <div class="flex justify-end gap-3 pt-3 border-t border-gray-100">
            <a asp-action="Details" asp-route-id="@Model.OrderId"
               class="px-5 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50">
                Keep Order
            </a>
            <button type="submit"
                    onclick="return confirm('Confirm cancelling this order? This cannot be undone.')"
                    class="px-5 py-2.5 bg-rose-600 hover:bg-rose-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                Cancel Order
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}