@model IEnumerable<Kayane.ViewModels.CustomerOrderSummaryVM>

@{
    ViewData["Title"] = "My Orders";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="border-b border-gray-200 pb-4">
        <h1 class="text-3xl font-bold text-gray-900">My Orders</h1>
        <p class="text-sm text-gray-500 mt-1">Track and view history of all your past purchases.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white border border-gray-200 rounded-2xl p-12 text-center space-y-4">
            <p class="text-gray-500">You haven't placed any orders yet.</p>
            <a asp-controller="Store" asp-action="Index" class="inline-block px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition shadow-sm">
                Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            <th class="py-4 px-6">Order ID</th>
                            <th class="py-4 px-6">Date</th>
                            <th class="py-4 px-6">Items</th>
                            <th class="py-4 px-6">Total Amount</th>
                            <th class="py-4 px-6">Payment</th>
                            <th class="py-4 px-6">Fulfillment</th>
                            <th class="py-4 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var order in Model)
                        {
                            <tr class="hover:bg-gray-50/50 transition">
                                <td class="py-4 px-6 font-mono text-xs text-gray-600">@order.OrderId.ToString().Substring(0, 8)...</td>
                                <td class="py-4 px-6 text-gray-900">@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="py-4 px-6 text-gray-600">@order.ItemCount item(s)</td>
                                <td class="py-4 px-6 font-bold text-gray-900">$@order.TotalAmount.ToString("F2")</td>
                                <td class="py-4 px-6">
                                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full @(order.PaymentStatus == PaymentStatus.Success ? "bg-emerald-50 text-emerald-700 border border-emerald-200" : "bg-amber-50 text-amber-700 border border-amber-200")">
                                        @order.PaymentStatus
                                    </span>
                                </td>
                                <td class="py-4 px-6">
                                    <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700 border border-gray-200">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-right">
                                    <a asp-action="Details" asp-route-id="@order.OrderId" class="inline-flex items-center px-3 py-1.5 border border-gray-300 hover:border-gray-400 rounded-lg text-xs font-semibold text-gray-700 bg-white hover:bg-gray-50 transition shadow-sm">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>