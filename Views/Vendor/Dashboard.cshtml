@model Kayane.ViewModels.VendorDashboardVM

@{
    ViewData["Title"] = "Vendor Dashboard";
}

<div class="w-full px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-extrabold text-gray-900">@Model.Vendor.BusinessName Dashboard</h1>
            <p class="text-sm text-gray-500 mt-1">Manage your store products, earnings, and withdrawal requests.</p>
        </div>
        <a asp-action="Products"
           class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 transition shadow-sm">
            Manage Products
        </a>
        <a asp-action="CreateProduct"
           class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
            + Add Product
        </a>
        <a asp-action="EditProfile"
           class="px-4 py-2 bg-white border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 transition shadow-sm">
            Edit Store & Bank Details
        </a>
        <a asp-controller="VendorWallet" asp-action="Index"
           class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
            View Wallet & Payouts
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-green-50 border-l-4 border-green-400 text-green-700 rounded-r-lg shadow-sm">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-red-50 border-l-4 border-red-400 text-red-700 rounded-r-lg shadow-sm">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Vendor Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Available Wallet Balance</p>
            <p class="text-3xl font-extrabold text-gray-900 mt-2">₦@(Model.Wallet?.Balance.ToString("N2") ?? "0.00")</p>
            <p class="text-xs text-emerald-600 font-semibold mt-1">Ready for payout request</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Lifetime Earnings</p>
            <p class="text-3xl font-extrabold text-gray-900 mt-2">₦@Model.TotalEarnings.ToString("N2")</p>
            <p class="text-xs text-gray-400 mt-1">Gross earnings processed</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Store Products</p>
            <p class="text-3xl font-extrabold text-gray-900 mt-2">@Model.TotalProducts</p>
            <p class="text-xs text-amber-600 font-semibold mt-1">@Model.PendingProducts pending moderation</p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Account Status</p>
            <p class="text-2xl font-extrabold text-green-600 mt-2">@Model.Vendor.Status</p>
            <p class="text-xs text-gray-400 mt-1">Active marketplace vendor</p>
        </div>
    </div>

    <!-- Recent Payout Transactions -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex items-center justify-between">
            <div>
                <h2 class="text-lg font-bold text-gray-900">Recent Payout Requests</h2>
                <p class="text-xs text-gray-500">Your latest withdrawal submissions.</p>
            </div>
            <a asp-controller="VendorWallet" asp-action="Index"
               class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">
                View Full History →
            </a>
        </div>

        @if (Model.RecentTransactions?.Any() == true)
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var tx in Model.RecentTransactions)
                        {
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                    @tx.CreatedAt.ToLocalTime().ToString("g")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-gray-900">
                                    ₦@tx.Amount.ToString("N2")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold
                                        @(tx.Status == "Approved" ? "bg-green-100 text-green-800" :
                                          tx.Status == "Rejected" ? "bg-red-100 text-red-800" :
                                          tx.Status == "Failed" ? "bg-red-100 text-red-800" :
                                          "bg-yellow-100 text-yellow-800")">
                                        @tx.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-sm text-gray-500">
                No payout requests submitted yet.
            </div>
        }
    </div>
</div>