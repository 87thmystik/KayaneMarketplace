@model List<Kayane.ViewModels.VendorProductListItemVM>
@using Kayane.Models

@{
    ViewData["Title"] = "My Product Inventory";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Product Management</h1>
            <p class="text-sm text-gray-500">Create listings, adjust pricing, and track inventory stock levels.</p>
        </div>
        <div class="flex items-center space-x-3">
            <a asp-controller="Vendor" asp-action="Payouts" asp-area="" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg transition text-sm">
                Wallet & Payouts
            </a>
            <a asp-action="CreateProduct" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg transition shadow-sm text-sm">
                + Add New Product
            </a>
        </div>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
            <div class="flex items-center gap-3">
                <a asp-action="Dashboard" asp-controller="Vendor" class="text-xs font-semibold text-gray-500 hover:text-gray-800">← Dashboard</a>
                <span class="text-gray-300">/</span>
                <a asp-action="Products" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">Products</a>
            </div>
            <!-- Action buttons (Add Product, Request Withdrawal, etc.) go here -->
        </div>
    </div>

    <!-- Success Flash Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium flex justify-between items-center">
            <span>@TempData["SuccessMessage"]</span>
            <button onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-900 font-bold">&times;</button>
        </div>
    }

    <!-- Inventory Table -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        @if (Model.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-xs uppercase font-semibold text-gray-500 border-b border-gray-200">
                            <th class="px-6 py-3.5">Product</th>
                            <th class="px-6 py-3.5">Category</th>
                            <th class="px-6 py-3.5">Price</th>
                            <th class="px-6 py-3.5">Stock Level</th>
                            <th class="px-6 py-3.5">Status</th>
                            <th class="px-6 py-3.5">Created</th>
                            <th class="px-6 py-3.5 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50/80 transition">
                                <td class="px-6 py-4 font-bold text-gray-900">@item.Name</td>
                                <td class="px-6 py-4 text-gray-600">@item.CategoryName</td>
                                <td class="px-6 py-4 font-semibold text-gray-900">@item.Price.ToString("C")</td>
                                <td class="px-6 py-4">
                                    <form asp-action="UpdateStock" method="post" class="flex items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="number" name="newStock" value="@item.Stock" min="0"
                                               class="w-20 px-2.5 py-1 border border-gray-300 rounded-lg text-xs font-semibold focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                                        <button type="submit" class="text-xs px-2.5 py-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium rounded-lg transition">
                                            Save
                                        </button>
                                    </form>
                                </td>
                                <td class="px-6 py-4">
                                    @switch (item.Status)
                                    {
                                        case ProductStatus.Approved:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                                                Approved
                                            </span>
                                            break;
                                        case ProductStatus.Pending:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
                                                Pending Review
                                            </span>
                                            break;
                                        default:
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                                                @item.Status
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="px-6 py-4 text-gray-500 text-xs">@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4 text-right">
                                    <a asp-action="EditProduct" asp-route-id="@item.ProductId" class="text-xs font-semibold text-indigo-600 hover:text-indigo-900 px-3 py-1.5 rounded-lg hover:bg-indigo-50 transition">
                                        Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center text-gray-500 space-y-3">
                <p class="text-base font-medium text-gray-900">No products found in your inventory.</p>
                <p class="text-xs text-gray-400">Add your first listing to start selling on Kayane.</p>
                <a asp-action="CreateProduct" class="inline-block mt-2 px-4 py-2 bg-indigo-600 text-white text-xs font-semibold rounded-lg hover:bg-indigo-700">
                    + Create Product
                </a>
            </div>
        }
    </div>
</div>