@model Kayane.ViewModels.VendorAnalyticsVM

@{
    ViewData["Title"] = "Vendor Analytics Dashboard";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <div class="border-b border-gray-200 pb-4">
        <h1 class="text-3xl font-bold text-gray-900">Sales Analytics</h1>
        <p class="text-sm text-gray-500 mt-1">Overview of your store performance, revenue, and top products.</p>
    </div>

    <!-- Metrics Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-2">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Revenue</span>
            <div class="text-2xl font-bold text-gray-950">$@Model.TotalRevenue.ToString("F2")</div>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-2">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">This Month's Revenue</span>
            <div class="text-2xl font-bold text-emerald-600">$@Model.CurrentMonthRevenue.ToString("F2")</div>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-2">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Fulfilled Orders</span>
            <div class="text-2xl font-bold text-gray-950">@Model.TotalOrdersFulfilled</div>
        </div>
        <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-2">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Pending Orders</span>
            <div class="text-2xl font-bold text-amber-600">@Model.PendingOrdersCount</div>
        </div>
    </div>

    <!-- Top Products Table -->
    <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm space-y-4">
        <h2 class="text-lg font-bold text-gray-900 border-b border-gray-100 pb-3">Top Performing Products</h2>
        @if (!Model.TopProducts.Any())
        {
            <p class="text-sm text-gray-500">No sales data available yet.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-600 uppercase tracking-wider">
                            <th class="py-3 px-4">Product Name</th>
                            <th class="py-3 px-4">Units Sold</th>
                            <th class="py-3 px-4">Revenue</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @foreach (var p in Model.TopProducts)
                        {
                            <tr class="hover:bg-gray-50/50">
                                <td class="py-3 px-4 font-semibold text-gray-900">@p.ProductName</td>
                                <td class="py-3 px-4 text-gray-600">@p.UnitsSold</td>
                                <td class="py-3 px-4 font-bold text-emerald-600">$@p.RevenueGenerated.ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>