@model Kayane.ViewModels.CartVM
@{
    ViewData["Title"] = "Shopping Cart & Checkout";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="border-b border-gray-200 pb-4">
        <h1 class="text-3xl font-extrabold text-gray-900">Your Shopping Cart</h1>
        <p class="text-sm text-gray-500">Review your selected items and complete your secure checkout.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-700 text-sm rounded-xl font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model?.Items == null || !Model.Items.Any())
    {
        <div class="bg-white rounded-2xl border border-gray-200 p-12 text-center space-y-4">
            <p class="text-gray-500 text-sm">Your cart is currently empty.</p>
            <a asp-controller="Shop" asp-action="Index" class="inline-block px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold rounded-xl transition">
                Explore Marketplace
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Cart Items List -->
            <div class="lg:col-span-2 space-y-4">
                <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 text-[11px] uppercase font-bold text-gray-400 border-b border-gray-200">
                                <th class="px-6 py-4">Product</th>
                                <th class="px-6 py-4">Price</th>
                                <th class="px-6 py-4">Qty</th>
                                <th class="px-6 py-4 text-right">Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-sm">
                            @foreach (var item in Model.Items)
                            {
                                <tr class="hover:bg-gray-50/50 transition">
                                    <td class="px-6 py-4 font-bold text-gray-900">@item.ProductName</td>
                                    <td class="px-6 py-4 text-gray-600">@item.UnitPrice.ToString("C")</td>
                                    <td class="px-6 py-4 text-gray-600">@item.Quantity</td>
                                    <td class="px-6 py-4 text-right font-extrabold text-emerald-600">@item.TotalPrice.ToString("C")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Checkout Summary & Form -->
            <div class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm space-y-6 h-fit">
                <h2 class="text-lg font-bold text-gray-900 border-b pb-3">Checkout</h2>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Checkout" asp-action="Process" method="post" class="space-y-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TotalAmount" value="@Model.GrandTotal" />

                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Full Name</label>
                            <input type="text" name="CustomerName" required placeholder="John Doe"
                                   value="@User.Identity.Name"
                                   class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Email Address</label>
                            <input type="email" name="CustomerEmail" required placeholder="john@example.com"
                                   value="@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value"
                                   class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Phone Number</label>
                            <input type="text" name="CustomerPhone" required placeholder="+234 800 000 0000"
                                   class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Shipping Address</label>
                            <textarea name="ShippingAddress" required rows="2" placeholder="Street address, city, state"
                                      class="w-full px-4 py-2.5 text-sm border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none"></textarea>
                        </div>

                        <div class="pt-4 border-t border-gray-100 flex items-center justify-between text-base font-extrabold text-gray-900">
                            <span>Grand Total:</span>
                            <span class="text-emerald-600">@Model.GrandTotal.ToString("C")</span>
                        </div>

                        <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl transition shadow-sm">
                            Proceed to Secure Payment
                        </button>
                    </form>
                }
                else
                {
                    <div class="space-y-4">
                        <p class="text-sm text-gray-600">
                            Please sign in to complete your purchase. Your cart will be saved.
                        </p>
                        <div class="pt-2 border-t border-gray-100 flex items-center justify-between text-base font-extrabold text-gray-900">
                            <span>Grand Total:</span>
                            <span class="text-emerald-600">@Model.GrandTotal.ToString("C")</span>
                        </div>
                        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="/Checkout"
                           class="block text-center w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm rounded-xl transition shadow-sm">
                            Sign In to Checkout
                        </a>
                        <p class="text-xs text-center text-gray-500">
                            Don't have an account?
                            <a asp-controller="Auth" asp-action="Register" asp-route-returnUrl="/Checkout"
                               class="text-indigo-600 font-semibold hover:underline">
                                Create one
                            </a>
                        </p>
                    </div>
                }
            </div>
        </div>
    }
</div>