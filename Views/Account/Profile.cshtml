@model Kayane.ViewModels.AccountProfileVM

@{
    ViewData["Title"] = "Profile";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <partial name="_AccountNav" />

        <main class="lg:col-span-3 space-y-6">
            <div class="border-b border-gray-200 pb-4">
                <h1 class="text-3xl font-extrabold text-gray-900">Profile</h1>
                <p class="text-sm text-gray-500 mt-1">Update your personal details.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium">
                    @TempData["SuccessMessage"]
                </div>
            }

            <form asp-action="Profile" method="post"
                  class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 font-medium"></div>

                <div>
                    <label asp-for="Name" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Full Name</label>
                    <input asp-for="Name" required
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="Name" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Email" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Email Address</label>
                    <input asp-for="Email" type="email" required
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
                    <p class="text-xs text-gray-400 mt-1">Changing your email will change how you sign in.</p>
                </div>

                <div>
                    <label asp-for="Phone" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Phone Number</label>
                    <input asp-for="Phone"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="Phone" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                    <a asp-action="Index" class="px-5 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50">Cancel</a>
                    <button type="submit"
                            class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                        Save Changes
                    </button>
                </div>
            </form>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}