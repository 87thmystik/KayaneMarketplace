@model List<Kayane.Models.BuyerAddress>

@{
    ViewData["Title"] = "Saved Addresses";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <partial name="_AccountNav" />

        <main class="lg:col-span-3 space-y-6">
            <div class="border-b border-gray-200 pb-4 flex items-center justify-between gap-4 flex-wrap">
                <div>
                    <h1 class="text-3xl font-extrabold text-gray-900">Saved Addresses</h1>
                    <p class="text-sm text-gray-500 mt-1">Use a saved address at checkout for faster ordering.</p>
                </div>
                <a asp-action="AddressForm"
                   class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                    + Add Address
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (!Model.Any())
            {
                <div class="bg-white rounded-2xl border border-gray-200 p-12 text-center space-y-3">
                    <div class="text-5xl">📭</div>
                    <p class="font-bold text-gray-900">No saved addresses yet</p>
                    <p class="text-sm text-gray-500">Add one to speed up your next checkout.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach (var a in Model)
                    {
                        <div class="bg-white rounded-2xl border @(a.IsDefault ? "border-indigo-300 ring-1 ring-indigo-200" : "border-gray-200") shadow-sm p-5 space-y-3 relative">
                            @if (a.IsDefault)
                            {
                                <span class="absolute top-3 right-3 px-2 py-0.5 bg-indigo-100 text-indigo-700 text-[10px] font-bold uppercase tracking-wider rounded-full">
                                    Default
                                </span>
                            }

                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">@a.Label</p>
                                <p class="font-bold text-gray-900 mt-1">@a.RecipientName</p>
                                <p class="text-xs text-gray-500 mt-0.5">@a.Phone</p>
                            </div>

                            <p class="text-sm text-gray-700 leading-relaxed">@a.FullAddress</p>

                            <div class="flex items-center gap-2 pt-3 border-t border-gray-100 flex-wrap">
                                <a asp-action="AddressForm" asp-route-id="@a.AddressId"
                                   class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 px-3 py-1.5 rounded-lg hover:bg-indigo-50 transition">
                                    Edit
                                </a>

                                @if (!a.IsDefault)
                                {
                                    <form asp-action="SetDefaultAddress" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.AddressId" />
                                        <button type="submit"
                                                class="text-xs font-semibold text-emerald-600 hover:text-emerald-800 px-3 py-1.5 rounded-lg hover:bg-emerald-50 transition">
                                            Set Default
                                        </button>
                                    </form>
                                }

                                <form asp-action="DeleteAddress" method="post" class="inline ml-auto">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@a.AddressId" />
                                    <button type="submit"
                                            onclick="return confirm('Remove this address?')"
                                            class="text-xs font-semibold text-rose-600 hover:text-rose-800 px-3 py-1.5 rounded-lg hover:bg-rose-50 transition">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>