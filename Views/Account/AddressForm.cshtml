@model Kayane.ViewModels.BuyerAddressFormVM

@{
    var isEdit = Model.AddressId.HasValue;
    ViewData["Title"] = isEdit ? "Edit Address" : "Add Address";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <partial name="_AccountNav" />

        <main class="lg:col-span-3 space-y-6">
            <div class="border-b border-gray-200 pb-4">
                <h1 class="text-3xl font-extrabold text-gray-900">@ViewData["Title"]</h1>
                <p class="text-sm text-gray-500 mt-1">@(isEdit ? "Update address details." : "Add a new delivery address.")</p>
            </div>

            <form asp-action="AddressForm" method="post"
                  class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 space-y-5">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="AddressId" />
                <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 font-medium"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="Label" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Label</label>
                        <input asp-for="Label" required placeholder="Home, Office, etc."
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        <span asp-validation-for="Label" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="RecipientName" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Recipient Name</label>
                        <input asp-for="RecipientName" required
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        <span asp-validation-for="RecipientName" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="Phone" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Phone</label>
                    <input asp-for="Phone" required placeholder="+234..."
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="Phone" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="AddressLine1" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Address Line 1</label>
                    <input asp-for="AddressLine1" required placeholder="Street, house number"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                    <span asp-validation-for="AddressLine1" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="AddressLine2" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Address Line 2 <span class="text-gray-400 normal-case font-normal">(optional)</span></label>
                    <input asp-for="AddressLine2" placeholder="Apartment, suite, landmark"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                        <label asp-for="City" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">City</label>
                        <input asp-for="City" required
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        <span asp-validation-for="City" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="State" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">State</label>
                        <input asp-for="State" required
                               class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
                        <span asp-validation-for="State" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="IsDefault" type="checkbox"
                           class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" />
                    <label asp-for="IsDefault" class="text-sm text-gray-700">Use this as my default delivery address</label>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                    <a asp-action="Addresses" class="px-5 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50">Cancel</a>
                    <button type="submit"
                            class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                        @(isEdit ? "Save Changes" : "Add Address")
                    </button>
                </div>
            </form>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}