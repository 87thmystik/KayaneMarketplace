@model Kayane.ViewModels.TwoFactorSetupVM

@{
    ViewData["Title"] = "Account Security";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <partial name="_AccountNav" />

        <main class="lg:col-span-3 space-y-6">
            <div class="border-b border-gray-200 pb-4">
                <h1 class="text-3xl font-extrabold text-gray-900">Account Security</h1>
                <p class="text-sm text-gray-500 mt-1">Manage two-factor authentication for your account.</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium">
                    @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-sm font-medium">
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (!ViewBag.TwoFactorEnabled)
            {
                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 space-y-5">
                    <div class="flex items-start gap-3">
                        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-2xl shrink-0">🔐</div>
                        <div>
                            <h2 class="text-lg font-bold text-gray-900">Two-Factor Authentication</h2>
                            <p class="text-sm text-gray-500 mt-1">
                                Add an extra layer of security. Requires an authenticator app like Google Authenticator, Authy, or 1Password.
                            </p>
                        </div>
                    </div>

                    <a asp-action="SetupTwoFactor"
                       class="inline-block px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                        Enable 2FA
                    </a>
                </div>
            }
            else
            {
                <div class="bg-white rounded-2xl border border-emerald-200 shadow-sm p-6 sm:p-8 space-y-5">
                    <div class="flex items-start gap-3">
                        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-2xl shrink-0">✓</div>
                        <div>
                            <h2 class="text-lg font-bold text-gray-900">Two-Factor Authentication</h2>
                            <p class="text-sm text-emerald-700 mt-1 font-medium">Enabled</p>
                            <p class="text-xs text-gray-500 mt-1">
                                You'll be asked for a 6-digit code each time you sign in.
                            </p>
                        </div>
                    </div>

                    <form asp-action="DisableTwoFactor" method="post"
                          onsubmit="return confirm('Disable 2FA? Your account will be less secure.');">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="px-5 py-2.5 bg-rose-50 hover:bg-rose-100 border border-rose-200 text-rose-700 text-sm font-semibold rounded-xl transition">
                            Disable 2FA
                        </button>
                    </form>
                </div>
            }
        </main>
    </div>
</div>