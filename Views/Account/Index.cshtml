@model Kayane.ViewModels.AccountDashboardVM

@{
    ViewData["Title"] = "My Account";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <partial name="_AccountNav" />

        <main class="lg:col-span-3 space-y-6">
            <div class="border-b border-gray-200 pb-4">
                <h1 class="text-3xl font-extrabold text-gray-900">Hi, @Model.Name.Split(' ').First()</h1>
                <p class="text-sm text-gray-500 mt-1">Member since @Model.MemberSince.ToString("MMM yyyy") · @Model.Email</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium">
                    @TempData["SuccessMessage"]
                </div>
            }

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Orders</p>
                    <p class="text-2xl font-extrabold text-gray-900 mt-1">@Model.TotalOrders</p>
                </div>
                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Active</p>
                    <p class="text-2xl font-extrabold text-amber-600 mt-1">@Model.ActiveOrders</p>
                </div>
                <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Reviews</p>
                    <p class="text-2xl font-extrabold text-gray-900 mt-1">@Model.ReviewCount</p>
                </div>
                <a asp-action="Notifications" class="block bg-white rounded-2xl border border-gray-200 shadow-sm p-5 hover:border-indigo-400 hover:shadow-md transition">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Unread</p>
                    <p class="text-2xl font-extrabold text-indigo-600 mt-1">@Model.UnreadNotifications</p>
                </a>
            </div>

            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div class="p-5 border-b border-gray-100 flex items-center justify-between">
                    <h2 class="text-base font-bold text-gray-900">Recent Orders</h2>
                    <a asp-controller="CustomerOrders" asp-action="Index"
                       class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">
                        View All →
                    </a>
                </div>

                @if (Model.RecentOrders.Any())
                {
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="bg-gray-50 border-b border-gray-200 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                <th class="py-3 px-5">Order</th>
                                <th class="py-3 px-5">Date</th>
                                <th class="py-3 px-5">Items</th>
                                <th class="py-3 px-5">Total</th>
                                <th class="py-3 px-5">Status</th>
                                <th class="py-3 px-5"></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr class="hover:bg-gray-50/50 transition">
                                    <td class="py-3 px-5 font-mono text-xs text-gray-600">#@order.OrderId.ToString().Substring(0, 8)</td>
                                    <td class="py-3 px-5 text-gray-700">@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="py-3 px-5 text-gray-600">@order.ItemCount item(s)</td>
                                    <td class="py-3 px-5 font-bold text-gray-900">@order.TotalAmount.ToString("C")</td>
                                    <td class="py-3 px-5">
                                        <span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-700">@order.Status</span>
                                    </td>
                                    <td class="py-3 px-5 text-right">
                                        <a asp-controller="CustomerOrders" asp-action="Details" asp-route-id="@order.OrderId"
                                           class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-10 text-center text-sm text-gray-500">
                        No orders yet.
                        <a asp-controller="Shop" asp-action="Index"
                           class="text-indigo-600 font-semibold hover:underline">Start shopping →</a>
                    </div>
                }
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <a asp-action="Profile" class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 hover:border-indigo-400 hover:shadow-md transition">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl">👤</div>
                        <div>
                            <p class="font-bold text-gray-900 text-sm">Edit Profile</p>
                            <p class="text-xs text-gray-500">Update your name, phone, or email</p>
                        </div>
                    </div>
                </a>
                <a asp-action="Addresses" class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 hover:border-indigo-400 hover:shadow-md transition">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl">📦</div>
                        <div>
                            <p class="font-bold text-gray-900 text-sm">Saved Addresses</p>
                            <p class="text-xs text-gray-500">@Model.AddressCount saved</p>
                        </div>
                    </div>
                </a>
            </div>
        </main>
    </div>
</div>