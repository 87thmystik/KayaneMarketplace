@model List<Kayane.ViewModels.AccountReviewItemVM>

@{
    ViewData["Title"] = "My Reviews";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <partial name="_AccountNav" />

        <main class="lg:col-span-3 space-y-6">
            <div class="border-b border-gray-200 pb-4">
                <h1 class="text-3xl font-extrabold text-gray-900">My Reviews</h1>
                <p class="text-sm text-gray-500 mt-1">Reviews you've left on products you purchased.</p>
            </div>

            @if (!Model.Any())
            {
                <div class="bg-white rounded-2xl border border-gray-200 p-12 text-center space-y-3">
                    <div class="text-5xl">💬</div>
                    <p class="font-bold text-gray-900">No reviews yet</p>
                    <p class="text-sm text-gray-500">Purchase a product to leave a review.</p>
                    <a asp-controller="CustomerOrders" asp-action="Index"
                       class="inline-block mt-3 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition">
                        View My Orders
                    </a>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    @foreach (var r in Model)
                    {
                        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-5 space-y-3">
                            <div class="flex items-start justify-between gap-3 flex-wrap">
                                <a asp-controller="Storefront" asp-action="Details" asp-route-id="@r.ProductId"
                                   class="font-bold text-gray-900 hover:text-indigo-600 transition">
                                    @r.ProductName
                                </a>
                                <span class="text-xs text-gray-400">@r.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            <div class="text-yellow-500 text-sm">
                                @for (int i = 0; i < r.Rating; i++) { <span>★</span> }
                                @for (int i = r.Rating; i < 5; i++) { <span class="text-gray-300">★</span> }
                            </div>
                            <p class="text-sm text-gray-700 whitespace-pre-line">@r.Comment</p>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>