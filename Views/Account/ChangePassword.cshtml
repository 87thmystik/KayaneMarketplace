@model Kayane.ViewModels.ChangePasswordVM

@{
    ViewData["Title"] = "Change Password";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <partial name="_AccountNav" />

        <main class="lg:col-span-3 space-y-6">
            <div class="border-b border-gray-200 pb-4">
                <h1 class="text-3xl font-extrabold text-gray-900">Change Password</h1>
                <p class="text-sm text-gray-500 mt-1">Choose a strong password you'll remember.</p>
            </div>

            <form asp-action="ChangePassword" method="post"
                  class="max-w-xl bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-sm text-rose-600 font-medium"></div>

                <div>
                    <label asp-for="CurrentPassword" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Current Password</label>
                    <input asp-for="CurrentPassword" type="password" required
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                           placeholder="••••••••" />
                    <span asp-validation-for="CurrentPassword" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="NewPassword" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">New Password</label>
                    <input asp-for="NewPassword" type="password" required minlength="6"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                           placeholder="Minimum 6 characters" />
                    <span asp-validation-for="NewPassword" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-1">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" required
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none"
                           placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-gray-100">
                    <a asp-action="Index" class="px-5 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50">Cancel</a>
                    <button type="submit"
                            class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                        Update Password
                    </button>
                </div>
            </form>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}