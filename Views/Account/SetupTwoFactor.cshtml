@model Kayane.ViewModels.TwoFactorSetupVM

@{
    ViewData["Title"] = "Set Up Two-Factor Authentication";
    var qrImageUrl = $"https://api.qrserver.com/v1/create-qr-code/?size=220x220&data={Uri.EscapeDataString(Model.QrCodeUrl)}";
}

<div class="max-w-2xl mx-auto px-4 py-8 space-y-6">

    <div>
        <a asp-action="Security" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800">← Back to Security</a>
        <h1 class="text-3xl font-extrabold text-gray-900 mt-2">Set Up Two-Factor Authentication</h1>
        <p class="text-sm text-gray-500 mt-1">Scan the QR code with your authenticator app, then confirm with a code.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl text-sm font-medium">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Step 1: Scan -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 space-y-5">
        <h2 class="text-lg font-bold text-gray-900">1. Scan the QR code</h2>

        <div class="flex flex-col sm:flex-row items-center gap-6">
            <div class="bg-white p-3 rounded-xl border-2 border-gray-200">
                <img src="@qrImageUrl" alt="2FA QR Code" class="w-52 h-52" />
            </div>

            <div class="flex-1 space-y-3 text-sm">
                <p class="text-gray-600">Open your authenticator app and scan this code.</p>
                <p class="text-xs text-gray-500">If you can't scan, enter this key manually:</p>
                <code class="block px-3 py-2 bg-gray-50 border border-gray-200 rounded-lg text-xs font-mono break-all">
                    @Model.Secret
                </code>
            </div>
        </div>
    </div>

    <!-- Step 2: Save recovery codes -->
    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 sm:p-8 space-y-4">
        <h2 class="text-lg font-bold text-amber-900">2. Save your recovery codes</h2>
        <p class="text-sm text-amber-800">
            Store these somewhere safe. Each can be used once if you lose access to your authenticator app.
        </p>
        <div class="grid grid-cols-2 gap-2 bg-white rounded-xl p-4 border border-amber-200 font-mono text-sm">
            @foreach (var code in Model.RecoveryCodes)
            {
                <div class="px-3 py-1.5 bg-gray-50 rounded text-center">@code</div>
            }
        </div>
    </div>

    <!-- Step 3: Confirm -->
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 sm:p-8 space-y-4">
        <h2 class="text-lg font-bold text-gray-900">3. Confirm the code</h2>
        <p class="text-sm text-gray-500">Enter the current 6-digit code from your app to enable 2FA.</p>

        <form asp-action="ConfirmTwoFactor" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="text" name="code" required inputmode="numeric" maxlength="6" pattern="[0-9]{6}"
                   placeholder="000000" autofocus
                   class="w-full max-w-xs px-4 py-3 border border-gray-300 rounded-xl text-lg text-center font-mono tracking-widest focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <div class="flex justify-end gap-3 pt-2">
                <a asp-action="Security" class="px-5 py-2.5 border border-gray-300 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50">
                    Cancel
                </a>
                <button type="submit"
                        class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl shadow-sm transition">
                    Enable 2FA
                </button>
            </div>
        </form>
    </div>
</div>