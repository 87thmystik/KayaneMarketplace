@model List<Kayane.ViewModels.AccountNotificationItemVM>

@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => !n.IsRead);
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <partial name="_AccountNav" />

        <main class="lg:col-span-3 space-y-6">
            <div class="border-b border-gray-200 pb-4 flex items-center justify-between gap-4 flex-wrap">
                <div>
                    <h1 class="text-3xl font-extrabold text-gray-900">Notifications</h1>
                    <p class="text-sm text-gray-500 mt-1">Updates about your orders and account.</p>
                </div>
                @if (unreadCount > 0)
                {
                    <form asp-action="MarkAllNotificationsRead" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-xl transition">
                            Mark All Read
                        </button>
                    </form>
                }
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-sm font-medium">
                    @TempData["SuccessMessage"]
                </div>
            }

            @if (!Model.Any())
            {
                <div class="bg-white rounded-2xl border border-gray-200 p-12 text-center space-y-3">
                    <div class="text-5xl">🔔</div>
                    <p class="font-bold text-gray-900">No notifications</p>
                    <p class="text-sm text-gray-500">We'll let you know when something happens.</p>
                </div>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var n in Model)
                    {
                        <div class="bg-white rounded-2xl border @(n.IsRead ? "border-gray-200" : "border-indigo-200 bg-indigo-50/30") shadow-sm p-4 flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center text-lg shrink-0
                                @(n.IsRead ? "bg-gray-100 text-gray-500" : "bg-indigo-100 text-indigo-600")">
                                @switch (n.Type)
                                {
                                    case "OrderUpdate": <span>📦</span> break;
                                    case "Promotion":   <span>🎉</span> break;
                                    case "SystemAlert": <span>⚠️</span> break;
                                    default:            <span>🔔</span> break;
                                }
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <p class="font-bold text-gray-900 text-sm">@n.Title</p>
                                    @if (!n.IsRead)
                                    {
                                        <span class="px-2 py-0.5 bg-indigo-100 text-indigo-700 text-[10px] font-bold uppercase tracking-wider rounded-full">New</span>
                                    }
                                </div>
                                <p class="text-sm text-gray-700 mt-1 leading-relaxed">@n.Message</p>
                                <p class="text-xs text-gray-400 mt-2">@n.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</p>
                            </div>
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkNotificationRead" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.NotificationId" />
                                    <button type="submit"
                                            class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 px-3 py-1.5 rounded-lg hover:bg-indigo-50 transition whitespace-nowrap">
                                        Mark Read
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</div>