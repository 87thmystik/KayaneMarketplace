@model Kayane.ViewModels.ResetPasswordVM
@{
    ViewData["Title"] = "Reset Password";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6 bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
        <div class="text-center">
            <h2 class="text-3xl font-extrabold text-gray-900">Set a New Password</h2>
            <p class="mt-2 text-sm text-gray-500">Choose a strong password you'll remember.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl font-medium">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="ResetPassword" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600"></div>

            <div>
                <label class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Email</label>
                <input value="@Model.Email" disabled
                       class="w-full px-3 py-2 border border-gray-200 rounded-xl text-sm bg-gray-50 text-gray-500" />
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">New Password</label>
                <input asp-for="NewPassword" type="password" required minlength="6"
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
                       placeholder="••••••••" />
                <span asp-validation-for="NewPassword" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" required
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
                       placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <button type="submit"
                    class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                Reset Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}