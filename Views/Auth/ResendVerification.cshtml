@{
    ViewData["Title"] = "Verify Your Email";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full bg-white p-8 rounded-2xl border border-gray-200 shadow-sm text-center space-y-5">
        <div class="text-5xl">✉️</div>
        <h1 class="text-2xl font-extrabold text-gray-900">Verify Your Email</h1>
        <p class="text-sm text-gray-500">
            We sent a verification link to your email address. Click the link in that email to activate your account.
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs rounded-xl font-medium">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl font-medium">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="ResendVerification" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="unused" value="1" />
            <button type="submit"
                    class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                Resend Verification Email
            </button>
        </form>

        <a asp-area="" asp-controller="Home" asp-action="Index"
           class="block text-xs font-semibold text-gray-500 hover:text-gray-800">
            Back to Home
        </a>
    </div>
</div>