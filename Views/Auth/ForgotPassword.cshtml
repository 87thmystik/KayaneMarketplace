@model Kayane.ViewModels.ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6 bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
        <div class="text-center">
            <h2 class="text-3xl font-extrabold text-gray-900">Forgot Password</h2>
            <p class="mt-2 text-sm text-gray-500">
                Enter your email and we'll send you a reset link.
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs rounded-xl font-medium">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl font-medium">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-action="ForgotPassword" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-xs font-semibold text-rose-600"></div>

            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-gray-700 uppercase tracking-wider mb-1">Email Address</label>
                <input asp-for="Email" type="email" required autofocus
                       class="w-full px-3 py-2 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
                       placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <button type="submit"
                    class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition shadow-sm">
                Send Reset Link
            </button>

            <p class="text-center text-xs text-gray-500 pt-2">
                Remembered it?
                <a asp-action="Login" class="text-indigo-600 font-semibold hover:underline">Back to sign in</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}